{%- comment -%}
  KRYO Setup — mobile-first owner companion  ·  /pages/kryo-setup
  Implements "KRYO OWNER SETUP — Mobile-First UX Upgrade Brief".

  Designed for a person holding an iPhone in one hand while installing hardware with the other.
  390px is the primary viewport. Desktop is a courtesy layout, never the basis for a decision.

  Zones: owner header (56px) · compact chapter progress · one physical action · sticky action bar.
  Gate: ONE acknowledgement, owned by getKryoOwnerState(). A returning owner never sees it twice.

  The hub's own modal gate is disabled (gate_enabled=false) so exactly one gate exists in the
  journey. Re-enabling it is a one-field revert in page.kryo-owner-hub.json.
{%- endcomment -%}

{{ 'kryo-owner.css' | asset_url | stylesheet_tag }}

{%- assign chapter_names = section.settings.chapter_names | split: ',' -%}

<div class="kryo-owner kryo-su" data-kryo-setup
     data-chapters="{{ section.settings.chapter_names | escape }}"
     data-hub="{{ section.settings.hub_url }}"
     data-safety-url="{{ section.settings.safety_url }}"
     data-wa="{{ section.settings.whatsapp_url }}"
     data-safety-version="{{ section.settings.safety_version }}"
     data-terms-version="{{ section.settings.terms_version }}"
     data-next="{{ section.settings.next_label | escape }}"
     data-already="{{ section.settings.already_label | escape }}"
     data-begin="{{ section.settings.begin_label | escape }}"
     data-continue="{{ section.settings.continue_label | escape }}"
     data-chapter-cta="{{ section.settings.chapter_cta | escape }}"
     data-gate-cta="{{ section.settings.gate_cta | escape }}"
     data-reack-cta="{{ section.settings.reack_cta | escape }}"
     data-reack-heading="{{ section.settings.reack_heading | escape }}"
     data-done-cta="{{ section.settings.complete_cta | escape }}"
     data-done-alt="{{ section.settings.complete_cta_secondary | escape }}"
     data-err-full="{{ section.settings.err_full | escape }}"
     data-err-ack="{{ section.settings.err_ack | escape }}">

  {%- comment -%} ===== ZONE 1a — owner header. No ecommerce nav, no cart. ===== {%- endcomment -%}
  <header class="kryo-su__bar">
    <a class="kryo-su__brand" href="{{ section.settings.hub_url }}" data-kryo-brand aria-label="Everest Labs owner guide">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: alt: 'Everest Labs', class: 'kryo-su__logo', loading: 'eager' }}
      {%- else -%}
        <span class="kryo-su__wordmark">EVEREST LABS</span>
      {%- endif -%}
    </a>
    <button type="button" class="kryo-su__help" data-kryo-help-open aria-label="{{ section.settings.help_aria }}">
      {{ section.settings.help_label }}
    </button>
  </header>

  {%- comment -%} ===== ZONE 1b — compact progress. Whole bar is the tap target. ===== {%- endcomment -%}
  <button type="button" class="kryo-su__prog" data-kryo-nav-open hidden aria-label="{{ section.settings.nav_aria }}">
    <span class="kryo-su__prog__row">
      <span class="kryo-su__prog__label" data-kryo-prog-label></span>
      <span class="kryo-su__prog__hint" aria-hidden="true">{{ section.settings.nav_hint }}</span>
    </span>
    <span class="kryo-su__segs" data-kryo-segs>
      {%- for name in chapter_names -%}
        <span class="kryo-su__seg" data-seg="{{ forloop.index }}"><i></i></span>
      {%- endfor -%}
    </span>
  </button>

  {%- comment -%} ===== GATE — one acknowledgement, never a second registration ===== {%- endcomment -%}
  <section class="kryo-su__screen" data-kryo-screen="gate" hidden>
    <div class="kryo-su__wrap">
      <p class="kryo-su__eyebrow" data-kryo-gate-eyebrow>{{ section.settings.gate_eyebrow }}</p>
      <h1 class="kryo-su__h1" tabindex="-1" data-kryo-gate-heading>{{ section.settings.gate_heading }}</h1>
      <div class="kryo-owner__note kryo-owner__note--critical">
        <p class="kryo-owner__note__title">{{ section.settings.gate_lead_title }}</p>
        {{ section.settings.gate_lead }}
      </div>
      <p class="kryo-su__body">{{ section.settings.gate_body }}</p>
      <p class="kryo-su__body" data-kryo-gate-reack hidden>{{ section.settings.gate_reack_body }}</p>
      <a class="kryo-su__opt kryo-su__opt--link" href="{{ section.settings.safety_url }}">{{ section.settings.gate_link }}</a>

      <form data-kryo-gate-form novalidate>
        <div data-kryo-gate-fields>
          <label class="kryo-su__f">
            <span>{{ section.settings.f_name }}</span>
            <input type="text" name="name" autocomplete="name" enterkeyhint="next">
          </label>
          <label class="kryo-su__f">
            <span>{{ section.settings.f_email }}</span>
            <input type="email" name="email" autocomplete="email" inputmode="email" enterkeyhint="done">
          </label>
        </div>
        <label class="kryo-su__check">
          <input type="checkbox" name="accept"><span>{{ section.settings.gate_accept }}</span>
        </label>
        <label class="kryo-su__check" data-kryo-gate-marketing>
          <input type="checkbox" name="marketing"><span>{{ section.settings.gate_marketing }}</span>
        </label>
        <p class="kryo-su__err" data-kryo-gate-err hidden role="alert"></p>
      </form>
    </div>
  </section>

  {%- comment -%} ===== START — compact, not a marketing hero ===== {%- endcomment -%}
  <section class="kryo-su__screen" data-kryo-screen="start" hidden>
    <div class="kryo-su__wrap">
      <p class="kryo-su__eyebrow">{{ section.settings.start_eyebrow }}</p>
      <h1 class="kryo-su__h1" tabindex="-1">{{ section.settings.start_heading }}</h1>
      <p class="kryo-su__body">{{ section.settings.start_body }}</p>
      <ol class="kryo-su__chlist">
        {%- for name in chapter_names -%}
          <li><span class="kryo-su__chnum">{{ forloop.index }}</span><span>{{ name | strip }}</span></li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.start_duration != blank -%}
        <p class="kryo-su__meta">{{ section.settings.start_duration }}</p>
      {%- endif -%}
      <label class="kryo-su__check kryo-su__wake" data-kryo-wake-row hidden>
        <input type="checkbox" data-kryo-wake>
        <span><strong>{{ section.settings.wake_label }}</strong><br>
          <span class="kryo-su__meta">{{ section.settings.wake_help }}</span></span>
      </label>
    </div>
  </section>

  {%- comment -%} ===== ZONE 2 — one physical action per screen ===== {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'setup_step' and block.settings.enabled -%}
      {%- assign is_locked = false -%}
      {%- if block.settings.warning_level == 'critical' or block.settings.allow_skip == false -%}
        {%- assign is_locked = true -%}
      {%- endif -%}
      <section class="kryo-su__screen kryo-su__step" data-kryo-step
               data-chapter="{{ block.settings.chapter }}"
               data-slug="{{ block.settings.title | handleize }}"
               data-locked="{% if is_locked %}1{% else %}0{% endif %}"
               data-cta="{{ block.settings.cta_label | escape }}"
               hidden {{ block.shopify_attributes }}>
        <div class="kryo-su__wrap">
          <p class="kryo-su__eyebrow">{{ block.settings.chapter_label }}</p>
          <h1 class="kryo-su__h1" tabindex="-1">{{ block.settings.title }}</h1>

          <div class="kryo-su__vis">
            {%- if block.settings.image != blank -%}
              <button type="button" class="kryo-su__imgbtn" data-kryo-zoom
                      data-src="{{ block.settings.image | image_url: width: 1600 }}"
                      aria-label="{{ section.settings.zoom_aria }}">
                {{ block.settings.image
                   | image_url: width: 860
                   | image_tag: loading: 'lazy', widths: '430,640,860',
                     sizes: '(min-width: 990px) 720px, 100vw',
                     alt: block.settings.image_alt | default: block.settings.title,
                     class: 'kryo-su__img' }}
              </button>
            {%- else -%}
              <div class="kryo-owner__placeholder kryo-su__ph">
                <strong>IMAGE REQUIRED</strong>
                <span>CHAPTER {{ block.settings.chapter }}</span>
                <span>{{ block.settings.title }}</span>
                <span>{{ block.settings.asset_id | default: 'KRYO-SETUP' }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.instruction != blank -%}
            <div class="kryo-su__body kryo-su__instr">{{ block.settings.instruction }}</div>
          {%- endif -%}

          {%- if block.settings.actions != blank -%}
            <div class="kryo-su__acts">{{ block.settings.actions }}</div>
          {%- endif -%}

          {%- if block.settings.warning != blank -%}
            <div class="kryo-owner__note kryo-owner__note--{{ block.settings.warning_level }}">
              {%- if block.settings.warning_title != blank -%}
                <p class="kryo-owner__note__title">{{ block.settings.warning_title }}</p>
              {%- else -%}
                <p class="kryo-owner__note__title">
                  {%- case block.settings.warning_level -%}
                    {%- when 'critical' -%}{{ section.settings.lbl_critical }}
                    {%- when 'info' -%}{{ section.settings.lbl_info }}
                    {%- else -%}{{ section.settings.lbl_caution }}
                  {%- endcase -%}
                </p>
              {%- endif -%}
              {{ block.settings.warning }}
            </div>
          {%- endif -%}

          {%- if block.settings.tip != blank -%}
            <div class="kryo-owner__note kryo-owner__note--info">
              <p class="kryo-owner__note__title">{{ section.settings.lbl_tip }}</p>
              {{ block.settings.tip }}
            </div>
          {%- endif -%}

          {%- if block.settings.why != blank -%}
            <details class="kryo-su__why">
              <summary>{{ section.settings.why_label }}</summary>
              <div class="kryo-su__body">{{ block.settings.why }}</div>
            </details>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ===== CHAPTER COMPLETE — brief, seconds not an obstacle ===== {%- endcomment -%}
  <section class="kryo-su__screen" data-kryo-screen="chapter" hidden>
    <div class="kryo-su__wrap kryo-su__centre">
      <div class="kryo-su__tick" aria-hidden="true"></div>
      <h1 class="kryo-su__h1" tabindex="-1" data-kryo-ch-done></h1>
      <p class="kryo-su__body" data-kryo-ch-next></p>
    </div>
  </section>

  {%- comment -%} ===== COMPLETE ===== {%- endcomment -%}
  <section class="kryo-su__screen" data-kryo-screen="done" hidden>
    <div class="kryo-su__wrap kryo-su__centre">
      <div class="kryo-su__tick" aria-hidden="true"></div>
      <h1 class="kryo-su__h1" tabindex="-1">{{ section.settings.complete_heading }}</h1>
      <p class="kryo-su__body">{{ section.settings.complete_body }}</p>
    </div>
  </section>

  {%- comment -%} ===== REVIEW MODE — permanent owner reference ===== {%- endcomment -%}
  <section class="kryo-su__screen" data-kryo-screen="review" hidden>
    <div class="kryo-su__wrap">
      <p class="kryo-su__eyebrow">{{ section.settings.start_eyebrow }}</p>
      <h1 class="kryo-su__h1" tabindex="-1">{{ section.settings.review_heading }}</h1>
      <p class="kryo-su__body">{{ section.settings.review_body }}</p>
      <div class="kryo-su__cards" data-kryo-review-cards></div>
      <a class="kryo-su__opt kryo-su__opt--link" style="margin-top:16px" href="{{ section.settings.hub_url }}">{{ section.settings.review_hub_link }}</a>
    </div>
  </section>

  {%- comment -%} ===== ZONE 3 — sticky action bar ===== {%- endcomment -%}
  <div class="kryo-su__bottom" data-kryo-bottom hidden>
    <button type="button" class="kryo-su__back" data-kryo-back>
      <span aria-hidden="true">&#8592;</span><span class="kryo-su__sr">{{ section.settings.back_label }}</span>
    </button>
    <div class="kryo-su__bottom__main">
      <button type="button" class="kryo-su__cta" data-kryo-next>{{ section.settings.next_label }}</button>
      <button type="button" class="kryo-su__alt" data-kryo-alt hidden>{{ section.settings.already_label }}</button>
    </div>
  </div>

  {%- comment -%} ===== SHEETS ===== {%- endcomment -%}
  <div class="kryo-su__sheet" data-kryo-sheet="nav" hidden>
    <div class="kryo-su__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.nav_heading }}">
      <div class="kryo-su__grab" aria-hidden="true"></div>
      <h2 class="kryo-su__h2">{{ section.settings.nav_heading }}</h2>
      <div data-kryo-nav-list></div>
      <button type="button" class="kryo-su__alt kryo-su__alt--sheet" data-kryo-sheet-close>{{ section.settings.close_label }}</button>
    </div>
  </div>

  <div class="kryo-su__sheet" data-kryo-sheet="help" hidden>
    <div class="kryo-su__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.help_heading }}">
      <div class="kryo-su__grab" aria-hidden="true"></div>
      <h2 class="kryo-su__h2">{{ section.settings.help_heading }}</h2>
      <div class="kryo-su__opts">
        {%- assign topics = section.settings.help_topics | split: ',' -%}
        {%- for t in topics -%}
          <button type="button" class="kryo-su__opt" data-kryo-topic="{{ t | strip | escape }}">{{ t | strip }}</button>
        {%- endfor -%}
      </div>
      <p class="kryo-su__meta" data-kryo-help-ctx></p>
      <a class="kryo-su__opt kryo-su__opt--link" href="{{ section.settings.safety_url }}">{{ section.settings.help_safety }}</a>
      <button type="button" class="kryo-su__alt kryo-su__alt--sheet" data-kryo-sheet-close>{{ section.settings.close_label }}</button>
    </div>
  </div>

  <div class="kryo-su__zoom" data-kryo-zoomview hidden>
    <button type="button" class="kryo-su__zoom__close" data-kryo-zoom-close aria-label="{{ section.settings.close_label }}">&#10005;</button>
    <img alt="" data-kryo-zoom-img>
  </div>
</div>

{% style %}
  /* Owner flow owns the screen. Storefront chrome is removed at runtime by JS as well;
     these rules cover the common Dawn nodes before JS runs, avoiding a visible flash. */
  .kryo-su { --bar:56px; --bot:84px; padding:0; }
  .kryo-su__sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }

  /* --- ZONE 1a: owner header --- */
  .kryo-su__bar { position:sticky; top:0; z-index:40; height:var(--bar);
    display:flex; align-items:center; justify-content:space-between; gap:12px; padding:0 20px;
    background:var(--kryo-white); border-bottom:1px solid var(--kryo-border); }
  .kryo-su__brand { display:inline-flex; align-items:center; min-height:48px; min-width:48px; text-decoration:none; }
  .kryo-su__logo { height:20px; width:auto; display:block; }
  .kryo-su__wordmark { font:700 13px/1 var(--kryo-font-body); letter-spacing:.14em; color:var(--kryo-text); }
  .kryo-su__help { min-height:48px; min-width:56px; padding:0 4px; border:0; background:none;
    font:600 16px/1 var(--kryo-font-body); color:var(--kryo-text); cursor:pointer; text-align:right; }

  /* --- ZONE 1b: chapter progress, tap to navigate --- */
  /* align-items:stretch is not optional here — the UA stylesheet sets align-items:flex-start
     on <button>, which collapsed the five chapter segments to a 16px sliver. */
  .kryo-su__prog { position:sticky; top:var(--bar); z-index:39; width:100%; min-height:56px;
    display:flex; flex-direction:column; justify-content:center; align-items:stretch;
    gap:9px; padding:11px 20px;
    background:var(--kryo-white); border:0; border-bottom:1px solid var(--kryo-border);
    cursor:pointer; text-align:left; font-family:var(--kryo-font-body); }
  .kryo-su__prog[hidden] { display:none; }
  .kryo-su__prog__row { display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .kryo-su__prog__label { font:700 11px/1.2 var(--kryo-font-body); letter-spacing:.12em;
    text-transform:uppercase; color:var(--kryo-text); }
  .kryo-su__prog__hint { font:600 11px/1.2 var(--kryo-font-body); letter-spacing:.06em;
    text-transform:uppercase; color:var(--kryo-text-tertiary); flex:0 0 auto; }
  .kryo-su__segs { display:flex; gap:4px; }
  .kryo-su__seg { flex:1; height:4px; border-radius:999px; background:var(--kryo-border); overflow:hidden; }
  .kryo-su__seg i { display:block; height:100%; width:0; border-radius:999px; background:var(--kryo-blue);
    transition:width 220ms ease; }
  .kryo-su__seg[data-state="done"] i { width:100% !important; }
  .kryo-su__seg[data-state="current"] { box-shadow:0 0 0 1px var(--kryo-border-strong); }

  /* --- ZONE 2: content --- */
  .kryo-su__screen { display:none; }
  .kryo-su__screen[data-active] { display:block; }
  /* The sticky bar already says "UNBOX & POSITION · 1 OF 3"; repeating it in the step eyebrow
     spends ~30px of the first screen saying nothing new. Kept in the markup for the no-JS
     fallback, where there is no progress bar to carry the chapter. */
  .kryo-su[data-js] .kryo-su__step .kryo-su__eyebrow { display:none; }
  .kryo-su__wrap { padding:20px 20px calc(var(--bot) + 40px); max-width:640px; margin:0 auto; }
  .kryo-su__centre { text-align:center; padding-top:64px; }
  .kryo-su__eyebrow { font:700 11px/1.3 var(--kryo-font-body); letter-spacing:.12em; text-transform:uppercase;
    color:var(--kryo-text-secondary); margin:0 0 10px; }
  .kryo-su__h1 { font-family:var(--kryo-font-heading); font-size:30px; line-height:1.12; font-weight:700;
    letter-spacing:-.02em; color:var(--kryo-text); margin:0 0 18px; outline:none; }
  /* The heading is focused programmatically so assistive tech announces the new step.
     It is not an interactive control, so it must not paint a focus ring — every real
     control below keeps one. */
  .kryo-su__h1:focus, .kryo-su__h1:focus-visible { outline:none; }
  .kryo-su__h2 { font-family:var(--kryo-font-heading); font-size:20px; line-height:1.2; font-weight:700;
    color:var(--kryo-text); margin:0 0 14px; }
  .kryo-su__body { font-size:16px; line-height:1.5; color:var(--kryo-text-secondary); margin:0 0 16px; }
  .kryo-su__body p { margin:0 0 12px; font-size:16px; line-height:1.5; }
  .kryo-su__body p:last-child { margin-bottom:0; }
  .kryo-su__instr { color:var(--kryo-text); }
  .kryo-su__acts { margin:0 0 18px; }
  .kryo-su__acts ol, .kryo-su__acts ul { margin:0; padding-left:22px; }
  .kryo-su__acts li { margin-bottom:10px; font-size:16px; line-height:1.5; color:var(--kryo-text); }
  .kryo-su__meta { font-size:14px; line-height:1.45; color:var(--kryo-text-tertiary); margin:0 0 14px; }
  /* Any inline link inside setup still has to be tappable with wet hands. */
  .kryo-su__link { color:var(--kryo-blue); font-weight:600; display:inline-flex; align-items:center;
    min-height:48px; }
  .kryo-su__opt--link { color:var(--kryo-blue); margin-bottom:18px; }
  .kryo-su__why { border-top:1px solid var(--kryo-border); padding-top:6px; margin-top:20px; }
  .kryo-su__why summary { cursor:pointer; font:600 15px/1.4 var(--kryo-font-body); color:var(--kryo-text);
    min-height:48px; display:flex; align-items:center; }
  .kryo-su .kryo-owner__note { margin:0 0 16px; }

  /* Instructional visual — 4:3, ahead of the copy, tap for fullscreen */
  .kryo-su__vis { margin:0 0 18px; }
  .kryo-su__imgbtn { display:block; width:100%; padding:0; border:0; background:none; cursor:zoom-in;
    border-radius:15px; overflow:hidden; }
  .kryo-su__img { width:100%; aspect-ratio:4/3; object-fit:cover; display:block;
    background:var(--kryo-surface); border-radius:15px; }
  .kryo-su__ph { width:100%; aspect-ratio:4/3; border-radius:15px; margin:0; }

  .kryo-su__chlist { list-style:none; margin:0 0 20px; padding:0; }
  .kryo-su__chlist li { display:flex; align-items:center; gap:12px; padding:12px 0;
    border-bottom:1px solid var(--kryo-border); font:600 16px/1.3 var(--kryo-font-body); color:var(--kryo-text); }
  .kryo-su__chnum { flex:0 0 auto; width:24px; height:24px; border-radius:999px; background:var(--kryo-surface);
    display:inline-flex; align-items:center; justify-content:center; font-size:12px; color:var(--kryo-text-secondary); }

  /* --- ZONE 3: sticky action bar --- */
  .kryo-su__bottom { position:fixed; left:0; right:0; bottom:0; z-index:41; display:flex; gap:12px; align-items:center;
    padding:12px 20px calc(12px + env(safe-area-inset-bottom));
    background:var(--kryo-white); border-top:1px solid var(--kryo-border); }
  .kryo-su__bottom[hidden] { display:none; }
  .kryo-su__bottom__main { flex:1; display:flex; flex-direction:column; gap:6px; min-width:0; }
  .kryo-su__back { flex:0 0 auto; width:56px; height:56px; border-radius:999px; font-size:18px;
    border:1px solid var(--kryo-border-strong); background:var(--kryo-white); color:var(--kryo-text); cursor:pointer; }
  .kryo-su__back[disabled] { opacity:.3; pointer-events:none; }
  .kryo-su__cta { width:100%; min-height:56px; padding:0 18px; border:0; border-radius:999px;
    background:var(--kryo-ink); color:#fff; font:600 17px/1.2 var(--kryo-font-body); cursor:pointer;
    transition:transform 100ms ease, opacity 100ms ease; }
  .kryo-su__cta:active { transform:scale(.985); opacity:.9; }
  .kryo-su__alt { width:100%; min-height:48px; border:0; background:none; color:var(--kryo-text-secondary);
    font:600 15px/1 var(--kryo-font-body); cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
  .kryo-su__alt[hidden] { display:none; }
  .kryo-su__alt--sheet { margin-top:8px; }
  .kryo-su__back:focus-visible, .kryo-su__cta:focus-visible, .kryo-su__alt:focus-visible,
  .kryo-su__help:focus-visible, .kryo-su__prog:focus-visible, .kryo-su__opt:focus-visible,
  .kryo-su__navrow:focus-visible, .kryo-su__card:focus-visible
    { outline:2px solid var(--kryo-blue); outline-offset:2px; }

  /* --- Sheets --- */
  .kryo-su__sheet { position:fixed; inset:0; z-index:60; background:rgba(23,26,28,.5); display:flex; align-items:flex-end; }
  .kryo-su__sheet[hidden] { display:none; }
  .kryo-su__panel { background:var(--kryo-white); width:100%; max-height:86vh; overflow-y:auto;
    padding:10px 20px calc(20px + env(safe-area-inset-bottom)); border-radius:20px 20px 0 0;
    animation:kryoSheetIn 200ms cubic-bezier(.2,.7,.3,1) both; }
  @keyframes kryoSheetIn { from { transform:translateY(18px); opacity:0 } to { transform:none; opacity:1 } }
  .kryo-su__grab { width:38px; height:4px; border-radius:999px; background:var(--kryo-border); margin:0 auto 14px; }
  .kryo-su__navch { font:700 11px/1.2 var(--kryo-font-body); letter-spacing:.1em; text-transform:uppercase;
    color:var(--kryo-text-tertiary); margin:20px 0 2px; }
  .kryo-su__navrow { display:flex; align-items:center; gap:12px; width:100%; min-height:52px; padding:13px 4px;
    border:0; border-bottom:1px solid var(--kryo-border); background:none; text-align:left; cursor:pointer;
    font:500 16px/1.3 var(--kryo-font-body); color:var(--kryo-text); }
  .kryo-su__navrow[data-state="current"] { font-weight:700; }
  .kryo-su__navdot { flex:0 0 auto; width:22px; height:22px; border-radius:999px; border:2px solid var(--kryo-border);
    display:inline-flex; align-items:center; justify-content:center; font-size:12px; line-height:1; color:#fff; }
  .kryo-su__navrow[data-state="done"] .kryo-su__navdot { background:var(--kryo-success); border-color:var(--kryo-success); }
  .kryo-su__navrow[data-state="done"] .kryo-su__navdot::after { content:'\2713'; }
  .kryo-su__navrow[data-state="current"] .kryo-su__navdot { background:var(--kryo-ink); border-color:var(--kryo-ink); }
  .kryo-su__navrow[data-state="current"] .kryo-su__navdot::after { content:'\2022'; }
  .kryo-su__opts { display:flex; flex-direction:column; gap:8px; margin-bottom:12px; }
  .kryo-su__opt { display:flex; align-items:center; min-height:52px; padding:0 16px; border:1px solid var(--kryo-border);
    border-radius:12px; background:var(--kryo-white); font:600 16px/1.2 var(--kryo-font-body);
    color:var(--kryo-text); text-align:left; text-decoration:none; cursor:pointer; }
  .kryo-su__opt:active { background:var(--kryo-surface); }

  /* --- Fullscreen image --- */
  .kryo-su__zoom { position:fixed; inset:0; z-index:80; background:#0d0f10;
    display:flex; align-items:center; justify-content:center; padding:16px; }
  .kryo-su__zoom[hidden] { display:none; }
  .kryo-su__zoom img { max-width:100%; max-height:100%; object-fit:contain; }
  .kryo-su__zoom__close { position:absolute; top:calc(12px + env(safe-area-inset-top)); right:12px;
    width:48px; height:48px; border-radius:999px; border:0; background:rgba(255,255,255,.18);
    color:#fff; font-size:18px; cursor:pointer; }

  /* --- Gate form --- */
  .kryo-su__f { display:block; margin:0 0 14px; }
  .kryo-su__f span { display:block; font:600 13px/1 var(--kryo-font-body); color:var(--kryo-text-secondary); margin-bottom:6px; }
  .kryo-su__f input { width:100%; min-height:52px; padding:12px 14px; font-size:16px; font-family:var(--kryo-font-body);
    background:var(--kryo-white); color:var(--kryo-text); border:1px solid var(--kryo-border-strong); border-radius:12px; }
  .kryo-su__f input:focus-visible { outline:2px solid var(--kryo-blue); outline-offset:1px; }
  .kryo-su__check { display:flex; gap:12px; align-items:flex-start; margin:0 0 14px; min-height:48px;
    padding:4px 0; font-size:14px; line-height:1.5; color:var(--kryo-text-secondary); cursor:pointer; }
  .kryo-su__check input { margin-top:2px; width:22px; height:22px; flex:0 0 auto; }
  .kryo-su__check[hidden] { display:none; }
  .kryo-su__err { color:var(--kryo-danger); font-size:14px; font-weight:600; margin:8px 0 0; }
  .kryo-su__wake { border-top:1px solid var(--kryo-border); padding-top:16px; margin-top:4px; }

  /* --- Completion tick --- */
  .kryo-su__tick { width:56px; height:56px; margin:0 auto 20px; border-radius:999px;
    background:var(--kryo-success-bg); position:relative; }
  .kryo-su__tick::after { content:'\2713'; position:absolute; inset:0; display:flex; align-items:center;
    justify-content:center; color:var(--kryo-success); font-size:26px; font-weight:700;
    animation:kryoTick 260ms cubic-bezier(.2,.7,.3,1) both; }
  @keyframes kryoTick { from { transform:scale(.6); opacity:0 } to { transform:none; opacity:1 } }

  .kryo-su__cards { display:flex; flex-direction:column; gap:10px; }
  .kryo-su__card { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%;
    min-height:64px; padding:14px 16px; border:1px solid var(--kryo-border); border-radius:14px;
    background:var(--kryo-white); font:600 16px/1.3 var(--kryo-font-body); color:var(--kryo-text);
    text-align:left; cursor:pointer; }
  .kryo-su__card__meta { font-size:13px; font-weight:600; color:var(--kryo-text-tertiary); flex:0 0 auto; }

  /* --- Motion: directional step transition --- */
  .kryo-su__screen[data-active] { animation:kryoStepIn 200ms cubic-bezier(.2,.7,.3,1) both; }
  .kryo-su[data-dir="back"] .kryo-su__screen[data-active] { animation-name:kryoStepBack; }
  @keyframes kryoStepIn   { from { opacity:0; transform:translateX(12px) }  to { opacity:1; transform:none } }
  @keyframes kryoStepBack { from { opacity:0; transform:translateX(-12px) } to { opacity:1; transform:none } }
  @media (prefers-reduced-motion: reduce) {
    .kryo-su__screen[data-active], .kryo-su__panel, .kryo-su__tick::after { animation:none !important; }
    .kryo-su__seg i { transition:none; }
    .kryo-su__cta:active { transform:none; }
  }

  /* --- No-JS: never a blank page --- */
  .kryo-su:not([data-js]) .kryo-su__step { display:block; }
  .kryo-su:not([data-js]) .kryo-su__wrap { padding-bottom:32px; }
  .kryo-su:not([data-js]) .kryo-su__prog,
  .kryo-su:not([data-js]) .kryo-su__bottom { display:none !important; }

  /* --- Desktop: same flow, wider measure. Never the basis for a decision. --- */
  @media (min-width:990px) {
    .kryo-su__wrap { max-width:720px; padding-top:32px; }
    .kryo-su__h1 { font-size:38px; }
    .kryo-su__bar, .kryo-su__prog { padding-left:32px; padding-right:32px; }
    .kryo-su__bottom { justify-content:center; padding-left:32px; padding-right:32px; }
    .kryo-su__bottom__main { max-width:420px; }
    .kryo-su__sheet { align-items:center; justify-content:center; }
    .kryo-su__panel { max-width:520px; border-radius:20px; max-height:80vh; }
  }
{% endstyle %}

<script>
(function () {
  var root = document.querySelector('[data-kryo-setup]');
  if (!root) return;
  root.setAttribute('data-js', '');

  var API   = 'https://everest-calendar.vercel.app/api/marketing/sync/storefront-event';
  var PKEY  = 'kryo_setup_progress_v1';
  var AKEY  = 'kryo_safety_accepted_v1';
  var WKEY  = 'kryo_wake_pref_v1';
  var SVER  = root.getAttribute('data-safety-version') || '1';
  var TVER  = root.getAttribute('data-terms-version') || '1';
  var HUB   = root.getAttribute('data-hub') || '/pages/kryo-resources';
  var WA    = root.getAttribute('data-wa') || '';
  var CH    = (root.getAttribute('data-chapters') || '').split(',').map(function (s) { return s.trim(); });

  var steps  = [].slice.call(root.querySelectorAll('[data-kryo-step]'));
  if (!steps.length) return;
  var TOTALCH = CH.length || 5;

  var screens = {};
  ['gate', 'start', 'chapter', 'done', 'review'].forEach(function (k) {
    screens[k] = root.querySelector('[data-kryo-screen="' + k + '"]');
  });

  var bottom  = root.querySelector('[data-kryo-bottom]');
  var cta     = root.querySelector('[data-kryo-next]');
  var altBtn  = root.querySelector('[data-kryo-alt]');
  var backBtn = root.querySelector('[data-kryo-back]');
  var progBtn = root.querySelector('[data-kryo-nav-open]');

  var chOf   = steps.map(function (s) { return parseInt(s.getAttribute('data-chapter'), 10) || 1; });
  var slugOf = steps.map(function (s, n) { return s.getAttribute('data-slug') || ('step-' + (n + 1)); });
  var lockOf = steps.map(function (s) { return s.getAttribute('data-locked') === '1'; });
  var firstOf = {}, countOf = {};
  chOf.forEach(function (c, n) { if (firstOf[c] === undefined) firstOf[c] = n; countOf[c] = (countOf[c] || 0) + 1; });
  function chName(c) { return CH[c - 1] || ('Chapter ' + c); }

  // ---- storage helpers: corrupt state is treated as new, never thrown ----
  function lget(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function lset(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function jparse(s) { try { return JSON.parse(s); } catch (e) { return null; } }

  function sessionId() {
    var o = jparse(lget('el_session') || lget('everest_session'));
    return o ? (o.id || o.session_id || null) : null;
  }
  function track(type, props) {
    try {
      var payload = JSON.stringify({
        event_type: type, session_id: sessionId(), anonymous_id: lget('el_anonymous_id'),
        page_path: location.pathname, page_url: location.href,
        ts: new Date().toISOString(), event_properties: props || {}
      });
      var blob = new Blob([payload], { type: 'text/plain;charset=UTF-8' });
      if (navigator.sendBeacon && navigator.sendBeacon(API, blob)) return;
      fetch(API, { method: 'POST', body: payload, keepalive: true });
    } catch (e) {}
  }

  // ---- ONE canonical owner state. Every gate decision reads this, nothing else. ----
  function getKryoOwnerState() {
    var acc = jparse(lget(AKEY)) || null;
    var prog = jparse(lget(PKEY)) || null;
    var accepted = !!(acc && acc.accepted_at);
    return {
      registered: !!(acc && acc.registered),
      safetyAccepted: accepted,
      safetyVersion: acc ? acc.safety_version : null,
      safetyCurrent: accepted && String(acc.safety_version) === String(SVER),
      currentChapter: prog ? (parseInt(prog.currentChapter, 10) || 1) : 1,
      currentStep: prog ? (parseInt(prog.currentStep, 10) || 0) : 0,
      completedSteps: prog ? (parseInt(prog.completedSteps, 10) || 0) : 0,
      setupComplete: !!(prog && prog.setupComplete)
    };
  }
  window.getKryoOwnerState = getKryoOwnerState;

  var S = getKryoOwnerState();
  var i = Math.min(Math.max(S.currentStep, 0), steps.length - 1);
  var furthest = Math.min(Math.max(S.completedSteps, i), steps.length);
  // Re-acknowledgement: they registered before, so never ask for their details again.
  var reAck = S.safetyAccepted && !S.safetyCurrent;
  var view;
  if (!S.safetyCurrent)      view = 'gate';
  else if (S.setupComplete)  view = 'review';
  else if (S.completedSteps > 0 || S.currentStep > 0) view = 'step';
  else                       view = 'start';

  function save(complete) {
    lset(PKEY, JSON.stringify({
      currentChapter: chOf[i], currentStep: i, completedSteps: furthest,
      setupComplete: complete === undefined ? (view === 'done' || view === 'review') : !!complete
    }));
  }

  // ---- Remove storefront distractions during active setup ----
  function stripChrome() {
    try {
      [].forEach.call(document.querySelectorAll('[id^="shopify-section"]'), function (s) {
        if (!s.contains(root)) s.style.display = 'none';
      });
      var noise = ['#chatway-container', 'chatway-widget', '#shopify-chat', '.announcement-bar',
                   '#ProductRecommendations', '.footer', '.newsletter-form'];
      noise.forEach(function (sel) {
        [].forEach.call(document.querySelectorAll(sel), function (el) {
          if (!el.contains(root)) el.style.display = 'none';
        });
      });
      document.body.style.background = '#fff';
    } catch (e) {}
  }
  stripChrome();
  // Third-party widgets inject late; re-run a few times rather than observing forever.
  var strips = 0, stripTimer = setInterval(function () {
    stripChrome(); if (++strips > 8) clearInterval(stripTimer);
  }, 700);

  // ---- Rendering ----
  function showScreen(el) {
    [].forEach.call(root.querySelectorAll('.kryo-su__screen'), function (s) {
      if (s === el) { s.setAttribute('data-active', ''); s.hidden = false; }
      else { s.removeAttribute('data-active'); s.hidden = true; }
    });
  }

  function focusHeading(el) {
    var h = el && el.querySelector('.kryo-su__h1');
    if (h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
  }

  function updateProgress() {
    var c = chOf[i];
    var within = i - firstOf[c] + 1;
    var label = root.querySelector('[data-kryo-prog-label]');
    if (label) label.textContent = chName(c).toUpperCase() + ' · ' + within + ' OF ' + countOf[c];
    [].forEach.call(root.querySelectorAll('[data-seg]'), function (seg) {
      var n = parseInt(seg.getAttribute('data-seg'), 10);
      var start = firstOf[n], cnt = countOf[n] || 0;
      var doneIn = start === undefined ? 0 : Math.max(0, Math.min(furthest - start, cnt));
      var state = cnt && doneIn >= cnt ? 'done' : (n === c ? 'current' : 'todo');
      seg.setAttribute('data-state', state);
      // The chapter you are standing in fills by POSITION, so step 1 of 3 reads as a third
      // rather than as an empty bar. Other chapters fill by what is actually complete.
      var shown = (state === 'current') ? Math.max(doneIn, within) : doneIn;
      var fill = seg.querySelector('i');
      if (fill) fill.style.width = cnt ? Math.round((Math.min(shown, cnt) / cnt) * 100) + '%' : '0%';
    });
  }

  function render(dir) {
    root.setAttribute('data-dir', dir === 'back' ? 'back' : 'fwd');
    progBtn.hidden = !(view === 'step' || view === 'chapter');
    bottom.hidden = (view === 'review');

    if (view === 'gate') {
      showScreen(screens.gate);
      var fields = root.querySelector('[data-kryo-gate-fields]');
      var mk = root.querySelector('[data-kryo-gate-marketing]');
      var reackBody = root.querySelector('[data-kryo-gate-reack]');
      if (fields) fields.hidden = reAck;
      if (mk) mk.hidden = reAck;
      if (reackBody) reackBody.hidden = !reAck;
      if (reAck) {
        var h = root.querySelector('[data-kryo-gate-heading]');
        if (h) h.textContent = root.getAttribute('data-reack-heading') || 'Safety information has been updated.';
      }
      cta.textContent = reAck
        ? (root.getAttribute('data-reack-cta') || 'I understand')
        : (root.getAttribute('data-gate-cta') || 'Accept and begin');
      altBtn.hidden = true;
      backBtn.disabled = true;
      focusHeading(screens.gate);
      track('kryo_safety_gate_view', { reack: reAck });
      return;
    }

    if (view === 'start') {
      showScreen(screens.start);
      cta.textContent = furthest > 0
        ? (root.getAttribute('data-continue') || 'Continue setup')
        : (root.getAttribute('data-begin') || 'Begin setup');
      altBtn.hidden = true;
      backBtn.disabled = true;
      focusHeading(screens.start);
      return;
    }

    if (view === 'review') {
      showScreen(screens.review);
      buildReview();
      focusHeading(screens.review);
      return;
    }

    if (view === 'done') {
      showScreen(screens.done);
      cta.textContent = root.getAttribute('data-done-cta') || 'Back to owner guide';
      altBtn.hidden = false;
      altBtn.textContent = root.getAttribute('data-done-alt') || 'Review first use';
      backBtn.disabled = false;
      focusHeading(screens.done);
      save(true);
      return;
    }

    if (view === 'chapter') {
      showScreen(screens.chapter);
      var c = chOf[i];
      var dEl = root.querySelector('[data-kryo-ch-done]');
      var nEl = root.querySelector('[data-kryo-ch-next]');
      if (dEl) dEl.textContent = chName(c) + ' complete.';
      if (nEl) nEl.textContent = c + 1 <= TOTALCH ? 'Next: ' + chName(c + 1) : '';
      cta.textContent = root.getAttribute('data-chapter-cta') || 'Continue';
      altBtn.hidden = true;
      backBtn.disabled = false;
      updateProgress();
      focusHeading(screens.chapter);
      return;
    }

    // ---- step ----
    var st = steps[i];
    showScreen(st);
    cta.textContent = st.getAttribute('data-cta') || (root.getAttribute('data-next') || 'Next');
    // "Already done" appears only on ordinary physical actions, never on comprehension screens.
    altBtn.hidden = lockOf[i];
    altBtn.textContent = root.getAttribute('data-already') || 'Already done';
    backBtn.disabled = (i === 0);
    updateProgress();
    window.scrollTo(0, 0);
    focusHeading(st);
    var nxt = steps[i + 1];
    if (nxt) { var im = nxt.querySelector('img'); if (im && im.currentSrc !== undefined) { var pre = new Image(); pre.src = im.getAttribute('src') || ''; } }
    save(false);
    track('kryo_setup_step_view', { chapter: chOf[i], step: i, slug: slugOf[i] });
  }

  // ---- History: browser Back walks the setup, not out of it ----
  function pushHistory(replace) {
    try {
      var hash = view === 'step' ? '#' + slugOf[i] : '#' + view;
      var st = { kryo: 1, view: view, i: i };
      if (replace || location.hash === hash) history.replaceState(st, '', hash);
      else history.pushState(st, '', hash);
    } catch (e) {}
  }

  function goto(nextView, nextIndex, dir) {
    view = nextView;
    if (typeof nextIndex === 'number') i = Math.min(Math.max(nextIndex, 0), steps.length - 1);
    render(dir);
    pushHistory(false);
  }

  window.addEventListener('popstate', function (e) {
    var st = e.state;
    if (st && st.kryo) { view = st.view; if (typeof st.i === 'number') i = st.i; render('back'); return; }
    var h = (location.hash || '').replace('#', '');
    var n = slugOf.indexOf(h);
    if (n > -1) { var back = n < i; view = 'step'; i = n; render(back ? 'back' : 'fwd'); }
  });

  // ---- Navigator sheet ----
  function buildNav() {
    var wrap = root.querySelector('[data-kryo-nav-list]');
    if (!wrap) return;
    wrap.innerHTML = '';
    for (var c = 1; c <= TOTALCH; c++) {
      if (firstOf[c] === undefined) continue;
      var head = document.createElement('p');
      head.className = 'kryo-su__navch';
      head.textContent = chName(c);
      wrap.appendChild(head);
      for (var n = firstOf[c]; n < firstOf[c] + countOf[c]; n++) {
        (function (n) {
          var state = n < furthest ? 'done' : (n === i ? 'current' : 'todo');
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'kryo-su__navrow';
          b.setAttribute('data-state', state);
          var dot = document.createElement('span');
          dot.className = 'kryo-su__navdot';
          var txt = document.createElement('span');
          var h1 = steps[n].querySelector('.kryo-su__h1');
          txt.textContent = h1 ? h1.textContent : ('Step ' + (n + 1));
          var sr = document.createElement('span');
          sr.className = 'kryo-su__sr';
          sr.textContent = state === 'done' ? ' (completed)' : (state === 'current' ? ' (current step)' : ' (not started)');
          b.appendChild(dot); b.appendChild(txt); b.appendChild(sr);
          b.addEventListener('click', function () {
            closeSheets();
            var back = n < i;
            if (n > furthest) furthest = n;
            track('kryo_setup_jump', { from: i, to: n, chapter: chOf[n] });
            goto('step', n, back ? 'back' : 'fwd');
          });
          wrap.appendChild(b);
        })(n);
      }
    }
  }

  function buildReview() {
    var wrap = root.querySelector('[data-kryo-review-cards]');
    if (!wrap) return;
    wrap.innerHTML = '';
    for (var c = 1; c <= TOTALCH; c++) {
      if (firstOf[c] === undefined) continue;
      (function (c) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'kryo-su__card';
        var t = document.createElement('span');
        t.textContent = chName(c);
        var m = document.createElement('span');
        m.className = 'kryo-su__card__meta';
        m.textContent = countOf[c] + ' steps';
        b.appendChild(t); b.appendChild(m);
        b.addEventListener('click', function () {
          track('kryo_setup_review_chapter', { chapter: c });
          goto('step', firstOf[c], 'fwd');
        });
        wrap.appendChild(b);
      })(c);
    }
  }

  var lastFocus = null;
  function openSheet(kind) {
    var s = root.querySelector('[data-kryo-sheet="' + kind + '"]');
    if (!s) return;
    lastFocus = document.activeElement;
    if (kind === 'nav') buildNav();
    if (kind === 'help') {
      var ctx = root.querySelector('[data-kryo-help-ctx]');
      if (ctx) ctx.textContent = view === 'step'
        ? chName(chOf[i]) + ' · step ' + (i - firstOf[chOf[i]] + 1) + ' of ' + countOf[chOf[i]]
        : '';
    }
    s.hidden = false;
    document.body.style.overflow = 'hidden';
    var f = s.querySelector('button, a');
    if (f) f.focus();
  }
  function closeSheets() {
    var open = false;
    [].forEach.call(root.querySelectorAll('.kryo-su__sheet'), function (s) { if (!s.hidden) open = true; s.hidden = true; });
    document.body.style.overflow = '';
    if (open && lastFocus && lastFocus.focus) lastFocus.focus();
  }

  // ---- Advance ----
  function advance(skipped) {
    if (view === 'gate') {
      var form = root.querySelector('[data-kryo-gate-form]');
      var err = root.querySelector('[data-kryo-gate-err]');
      var d = new FormData(form);
      var nm = (d.get('name') || '').toString().trim();
      var em = (d.get('email') || '').toString().trim();
      var needDetails = !reAck;
      var okEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em);
      if (!d.get('accept') || (needDetails && (!nm || !okEmail))) {
        if (err) {
          err.hidden = false;
          err.textContent = needDetails
            ? (root.getAttribute('data-err-full') || 'Please add your name, a valid email address and tick the acknowledgement.')
            : (root.getAttribute('data-err-ack') || 'Please tick the acknowledgement to continue.');
        }
        return;
      }
      if (err) err.hidden = true;
      var prev = jparse(lget(AKEY)) || {};
      // PII is deliberately not stored or sent to analytics; only that registration happened.
      lset(AKEY, JSON.stringify({
        registered: needDetails ? true : (prev.registered !== false),
        accepted_at: new Date().toISOString(),
        safety_version: SVER, terms_version: TVER,
        marketing: reAck ? !!prev.marketing : !!d.get('marketing')
      }));
      track('kryo_safety_accept', { reack: reAck, marketing: reAck ? !!prev.marketing : !!d.get('marketing') });
      reAck = false;
      var resume = getKryoOwnerState();
      if (resume.setupComplete) { goto('review', i, 'fwd'); return; }
      goto((furthest > 0 || i > 0) ? 'step' : 'start', i, 'fwd');
      return;
    }

    if (view === 'start') { track('kryo_setup_start', { resumed: furthest > 0 }); goto('step', i, 'fwd'); return; }

    if (view === 'chapter') {
      var n = Math.min(i + 1, steps.length - 1);
      if (n > furthest) furthest = n;
      goto('step', n, 'fwd');
      return;
    }

    if (view === 'done') { window.location.href = HUB; return; }

    // step
    track(skipped ? 'kryo_setup_step_skipped' : 'kryo_setup_step_complete', { chapter: chOf[i], step: i, slug: slugOf[i] });
    if (i + 1 > furthest) furthest = i + 1;
    if (i >= steps.length - 1) {
      furthest = steps.length;
      track('kryo_setup_complete', { steps: steps.length });
      goto('done', i, 'fwd');
      return;
    }
    if (chOf[i + 1] !== chOf[i]) { goto('chapter', i, 'fwd'); return; }
    goto('step', i + 1, 'fwd');
  }

  function goBack() {
    if (view === 'done') { goto('step', steps.length - 1, 'back'); return; }
    if (view === 'chapter') { goto('step', i, 'back'); return; }
    if (view === 'step' && i > 0) { goto('step', i - 1, 'back'); return; }
    if (view === 'step' && i === 0 && !bottom.hidden) { window.location.href = HUB; }
  }

  cta.addEventListener('click', function () { advance(false); });
  altBtn.addEventListener('click', function () {
    if (view === 'done') { goto('step', 0, 'back'); return; }
    advance(true);
  });
  backBtn.addEventListener('click', goBack);
  progBtn.addEventListener('click', function () { openSheet('nav'); });
  root.querySelector('[data-kryo-help-open]').addEventListener('click', function () {
    track('kryo_support_open', { surface: 'setup', chapter: chOf[i], step: i });
    openSheet('help');
  });

  root.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;

    if (t.closest('[data-kryo-sheet-close]') || t.classList.contains('kryo-su__sheet')) { closeSheets(); return; }

    var topic = t.closest('[data-kryo-topic]');
    if (topic) {
      var name = topic.getAttribute('data-kryo-topic');
      var where = view === 'step'
        ? chName(chOf[i]) + ' — step ' + (i - firstOf[chOf[i]] + 1) + ' of ' + countOf[chOf[i]] + ' (' + slugOf[i] + ')'
        : view;
      track('kryo_whatsapp_support_click', { surface: 'setup', topic: name, chapter: chOf[i], step: i });
      if (WA) {
        var msg = encodeURIComponent('KRYO setup help — ' + name + '. I am on: ' + where + '.');
        window.open(WA + (WA.indexOf('?') > -1 ? '&' : '?') + 'text=' + msg, '_blank', 'noopener');
      }
      closeSheets();
      return;
    }

    var zoom = t.closest('[data-kryo-zoom]');
    if (zoom) {
      var v = root.querySelector('[data-kryo-zoomview]');
      var img = root.querySelector('[data-kryo-zoom-img]');
      var inner = zoom.querySelector('img');
      img.src = zoom.getAttribute('data-src');
      img.alt = inner ? inner.alt : '';
      v.hidden = false;
      document.body.style.overflow = 'hidden';
      root.querySelector('[data-kryo-zoom-close]').focus();
      return;
    }
    if (t.closest('[data-kryo-zoom-close]')) {
      root.querySelector('[data-kryo-zoomview]').hidden = true;
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var z = root.querySelector('[data-kryo-zoomview]');
    if (z && !z.hidden) { z.hidden = true; document.body.style.overflow = ''; return; }
    closeSheets();
  });

  // ---- Screen Wake Lock: feature detected, optional, never required ----
  var wakeRow = root.querySelector('[data-kryo-wake-row]');
  var wakeBox = root.querySelector('[data-kryo-wake]');
  var lock = null;
  if ('wakeLock' in navigator && wakeRow && wakeBox) {
    wakeRow.hidden = false;
    if (lget(WKEY) === '1') wakeBox.checked = true;
    function requestLock() {
      try {
        navigator.wakeLock.request('screen').then(function (l) { lock = l; }, function () {});
      } catch (e) {}
    }
    function releaseLock() { try { if (lock) { lock.release(); lock = null; } } catch (e) {} }
    wakeBox.addEventListener('change', function () {
      lset(WKEY, wakeBox.checked ? '1' : '0');
      if (wakeBox.checked) requestLock(); else releaseLock();
    });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible' && wakeBox.checked && !lock) requestLock();
    });
    if (wakeBox.checked) requestLock();
  }

  // ---- Deep link wins over saved position, but never over the gate ----
  var hash = (location.hash || '').replace('#', '');
  if (view !== 'gate' && hash) {
    var idx = slugOf.indexOf(hash);
    if (idx > -1) { view = 'step'; i = idx; if (i > furthest) furthest = i; }
  }

  render('fwd');
  pushHistory(true);
})();
</script>

