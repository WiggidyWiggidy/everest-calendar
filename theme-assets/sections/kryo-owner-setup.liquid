{%- comment -%}
  KRYO Setup + First Use — /pages/kryo-setup
  Spec: §27-§38, §52, §54, §57

  ONE configurable section containing setup_step blocks (§27-28). Not a page per step.
  Each physical action is one screen/state (§31). Progress is "Chapter N of 5", never
  "Step 1 of 20" (§29-30). Body copy lives in block settings so future product revisions
  need no code (§54).

  Steps advance client-side; each step is a state, not a page load, so the customer keeps
  their place while holding a phone mid-installation.
{%- endcomment -%}

{{ 'kryo-owner.css' | asset_url | stylesheet_tag }}

{%- assign chapter_names = section.settings.chapter_names | split: ',' -%}

<div class="kryo-owner kryo-setup" data-kryo-setup
     data-total-chapters="{{ chapter_names.size }}"
     data-hub-url="{{ section.settings.hub_url }}">

  {%- comment -%} ---- Progress header (§30) — sticky, thin bar, no numbered circles ---- {%- endcomment -%}
  <div class="kryo-setup__topbar">
    <div class="kryo-owner__container">
      <p class="kryo-owner__progress__label" data-kryo-chapter-label>SETUP</p>
      <div class="kryo-owner__progress"><div class="kryo-owner__progress__bar" data-kryo-bar style="width:0%"></div></div>
    </div>
  </div>

  <div class="kryo-owner__container kryo-owner__guide">

    {%- comment -%} ---- Steps ---- {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'setup_step' and block.settings.enabled -%}
        <section class="kryo-setup__step" data-kryo-step data-chapter="{{ block.settings.chapter }}" {{ block.shopify_attributes }}>

          <p class="kryo-owner__eyebrow" data-kryo-step-eyebrow>{{ block.settings.chapter_label }}</p>
          <h1 class="kryo-owner__h1">{{ block.settings.title }}</h1>

          <div class="kryo-setup__visual">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag:
                   loading: 'lazy', alt: block.settings.title, class: 'kryo-setup__img' }}
            {%- else -%}
              {%- comment -%} Intentional placeholder at the eventual footprint (§57).
                              Never substitute a generic AI hardware image. {%- endcomment -%}
              <div class="kryo-owner__placeholder">
                <strong>IMAGE REQUIRED</strong>
                <span>SETUP / CHAPTER {{ block.settings.chapter }}</span>
                <span>{{ block.settings.title }}</span>
                <span>Asset ID: {{ block.settings.asset_id | default: 'KRYO-SETUP' }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.instruction != blank -%}
            <p class="kryo-owner__body kryo-owner__body--lead">{{ block.settings.instruction }}</p>
          {%- else -%}
            {%- comment -%} Copy not yet supplied. Spec: expose or hide, never guess. {%- endcomment -%}
            <div class="kryo-owner__note kryo-owner__note--info">
              <p class="kryo-owner__note__title">COPY REQUIRED</p>
              Instruction text for “{{ block.settings.title }}” is not yet supplied.
              Add it in the theme editor — this block is ready.
            </div>
          {%- endif -%}

          {%- if block.settings.warning != blank -%}
            <div class="kryo-owner__note kryo-owner__note--{{ block.settings.warning_level }}">
              {%- if block.settings.warning_title != blank -%}
                <p class="kryo-owner__note__title">{{ block.settings.warning_title }}</p>
              {%- endif -%}
              {{ block.settings.warning }}
            </div>
          {%- endif -%}

          {%- if block.settings.tip != blank -%}
            <div class="kryo-owner__note kryo-owner__note--info">{{ block.settings.tip }}</div>
          {%- endif -%}

          {%- comment -%} Technical detail belongs here, not in the instruction (§33) {%- endcomment -%}
          {%- if block.settings.why != blank -%}
            <details class="kryo-setup__why">
              <summary>{{ section.settings.why_label }}</summary>
              <p class="kryo-owner__body">{{ block.settings.why }}</p>
            </details>
          {%- endif -%}
        </section>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} ---- Completion (§36) — no confetti ---- {%- endcomment -%}
    <section class="kryo-setup__step" data-kryo-complete>
      <p class="kryo-owner__eyebrow">SETUP COMPLETE</p>
      <h1 class="kryo-owner__h1">{{ section.settings.complete_heading }}</h1>
      <p class="kryo-owner__body kryo-owner__body--lead">{{ section.settings.complete_body }}</p>
      <div class="kryo-owner__btn-row" style="margin-top:24px">
        <a href="{{ section.settings.hub_url }}" class="kryo-owner__btn kryo-owner__btn--primary">{{ section.settings.complete_cta }}</a>
        <a href="#" class="kryo-owner__btn kryo-owner__btn--secondary" data-kryo-review>{{ section.settings.complete_cta_secondary }}</a>
      </div>
    </section>

  </div>

  {%- comment -%} ---- Sticky Back/Next (§34). Next gets the emphasis. ---- {%- endcomment -%}
  <div class="kryo-setup__controls" data-kryo-controls>
    <button type="button" class="kryo-owner__btn kryo-owner__btn--secondary" data-kryo-back>{{ section.settings.back_label }}</button>
    <button type="button" class="kryo-owner__btn kryo-owner__btn--primary" data-kryo-next>{{ section.settings.next_label }}</button>
  </div>

  {%- comment -%} ---- Compact persistent support (§35) ---- {%- endcomment -%}
  {%- if section.settings.whatsapp_url != blank -%}
    <a href="{{ section.settings.whatsapp_url }}" class="kryo-setup__support" data-kryo-support rel="noopener" target="_blank">
      {{ section.settings.support_label }}
    </a>
  {%- endif -%}
</div>

{% style %}
  .kryo-setup__topbar { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,0.96);
    backdrop-filter: saturate(180%) blur(8px); border-bottom: 1px solid var(--kryo-border); padding: 12px 0 10px; }
  .kryo-setup__topbar .kryo-owner__progress { margin: 8px 0 0; }
  .kryo-setup__step { display: none; padding: 32px 0 140px; }
  .kryo-setup__step[data-active] { display: block; }
  .kryo-setup__visual { margin: 0 0 24px; }
  .kryo-setup__img { width: 100%; height: auto; display: block; border-radius: var(--kryo-radius-lg); }
  .kryo-setup__why { margin: 20px 0 0; border-top: 1px solid var(--kryo-border); padding-top: 16px; }
  .kryo-setup__why summary { cursor: pointer; font-weight: 600; font-size: 15px; color: var(--kryo-text); }
  .kryo-setup__why p { margin-top: 12px; }
  /* Sticky controls — 72px + safe area (§34). WhatsApp must never overlap (§34). */
  .kryo-setup__controls { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    display: flex; gap: 12px; align-items: center;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: var(--kryo-white); border-top: 1px solid var(--kryo-border); }
  .kryo-setup__controls .kryo-owner__btn { flex: 1; min-height: 48px; width: auto; }
  .kryo-setup__controls [data-kryo-next] { flex: 2; }
  .kryo-setup__support { position: fixed; right: 16px; z-index: 29;
    bottom: calc(84px + env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; padding: 10px 16px;
    background: var(--kryo-ink); color: var(--kryo-white); text-decoration: none;
    border-radius: 999px; font-size: 14px; font-weight: 600; }
  @media (min-width: 990px) {
    .kryo-setup__step { padding: 48px 0 160px; }
    .kryo-setup__controls { justify-content: flex-end; padding: 16px 32px; }
    .kryo-setup__controls .kryo-owner__btn { flex: 0 0 auto; min-width: 160px; }
    .kryo-setup__support { right: 32px; bottom: 96px; }
  }
{% endstyle %}

<script>
(function () {
  var root = document.querySelector('[data-kryo-setup]');
  if (!root) return;

  var EL_API = 'https://everest-calendar.vercel.app/api/marketing/sync/storefront-event';
  var KEY = 'kryo_setup_progress_v1';                       // §52
  var steps = Array.prototype.slice.call(root.querySelectorAll('[data-kryo-step]'));
  var done = root.querySelector('[data-kryo-complete]');
  var total = parseInt(root.getAttribute('data-total-chapters'), 10) || 5;
  if (!steps.length) return;

  function sid(){ try { var r=localStorage.getItem('el_session')||localStorage.getItem('everest_session');
    if(r){var o=JSON.parse(r);return o.id||o.session_id||null;} } catch(e){} return null; }

  function track(t, p){ try {
    var b=JSON.stringify({event_type:t,session_id:sid(),
      anonymous_id:localStorage.getItem('el_anonymous_id')||null,
      page_path:location.pathname,page_url:location.href,
      ts:new Date().toISOString(),event_properties:p||{}});
    var blob=new Blob([b],{type:'text/plain;charset=UTF-8'});
    if(navigator.sendBeacon&&navigator.sendBeacon(EL_API,blob))return;
    fetch(EL_API,{method:'POST',body:b,keepalive:true});
  } catch(e){} }

  function read(){ try { var r=localStorage.getItem(KEY); return r?JSON.parse(r):null; } catch(e){ return null; } }
  function write(o){ try { localStorage.setItem(KEY, JSON.stringify(o)); } catch(e){} }

  var i = 0, showingDone = false;
  var saved = read();
  if (saved) {
    if (saved.setupComplete) { showingDone = true; }
    else if (typeof saved.currentStep === 'number') { i = Math.min(Math.max(saved.currentStep,0), steps.length-1); }
  }

  function render() {
    steps.forEach(function(s,n){ if(n===i && !showingDone) s.setAttribute('data-active',''); else s.removeAttribute('data-active'); });
    if (done) { if (showingDone) done.setAttribute('data-active',''); else done.removeAttribute('data-active'); }

    var controls = root.querySelector('[data-kryo-controls]');
    if (controls) controls.style.display = showingDone ? 'none' : '';

    var ch = showingDone ? total : parseInt(steps[i].getAttribute('data-chapter'),10) || 1;
    var label = root.querySelector('[data-kryo-chapter-label]');
    var bar = root.querySelector('[data-kryo-bar]');
    if (label) label.textContent = showingDone ? 'SETUP · COMPLETE' : 'SETUP · CHAPTER ' + ch + ' OF ' + total;
    if (bar) bar.style.width = showingDone ? '100%' : Math.round(((i+1)/steps.length)*100) + '%';

    var back = root.querySelector('[data-kryo-back]');
    if (back) back.disabled = (i === 0);

    window.scrollTo({ top: 0, behavior: 'auto' });   // each step is a fresh screen (§31)

    if (!showingDone) {
      write({ currentChapter: ch, currentStep: i, completedSteps: i, setupComplete: false });
      track('kryo_setup_step_view', { chapter: ch, step: i });
    }
  }

  root.addEventListener('click', function (e) {
    var t = e.target;
    if (t.closest('[data-kryo-next]')) {
      var ch = parseInt(steps[i].getAttribute('data-chapter'),10) || 1;
      track('kryo_setup_step_complete', { chapter: ch, step: i });
      if (i < steps.length - 1) { i++; render(); }
      else { showingDone = true; write({ currentChapter: total, currentStep: i, completedSteps: steps.length, setupComplete: true });
             track('kryo_setup_complete', { steps: steps.length }); render(); }
    } else if (t.closest('[data-kryo-back]')) {
      if (showingDone) { showingDone = false; render(); }
      else if (i > 0) { i--; render(); }
    } else if (t.closest('[data-kryo-review]')) {
      e.preventDefault(); showingDone = false; i = 0; render();
    } else if (t.closest('[data-kryo-support]')) {
      var c = showingDone ? total : (parseInt(steps[i].getAttribute('data-chapter'),10) || 1);
      track('kryo_whatsapp_support_click', { surface: 'setup', chapter: c, step: i });
    }
  });

  track('kryo_setup_chapter_view', { resumed: !!saved });
  render();
})();
</script>

{% schema %}
{
  "name": "KRYO Setup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "chapter_names", "label": "Chapter names (comma separated)",
      "default": "Unbox & Position,Mount the Halo,Connect KRYO,Fill & Start,First Session" },
    { "type": "url", "id": "hub_url", "label": "Owner hub URL" },
    { "type": "text", "id": "why_label", "label": "Why-this-matters label", "default": "Why this matters" },
    { "type": "text", "id": "back_label", "label": "Back button", "default": "Back" },
    { "type": "text", "id": "next_label", "label": "Next button", "default": "Next" },
    { "type": "header", "content": "Support" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp URL" },
    { "type": "text", "id": "support_label", "label": "Support button", "default": "Get help" },
    { "type": "header", "content": "Completion" },
    { "type": "text", "id": "complete_heading", "label": "Heading", "default": "You're ready." },
    { "type": "textarea", "id": "complete_body", "label": "Body", "default": "Your KRYO is installed and you know how to start safely." },
    { "type": "text", "id": "complete_cta", "label": "Primary button", "default": "Back to owner hub" },
    { "type": "text", "id": "complete_cta_secondary", "label": "Secondary button", "default": "Review first use" }
  ],
  "blocks": [
    {
      "type": "setup_step",
      "name": "Setup step",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Enable step", "default": true },
        { "type": "range", "id": "chapter", "label": "Chapter", "min": 1, "max": 5, "step": 1, "default": 1 },
        { "type": "text", "id": "chapter_label", "label": "Chapter label" },
        { "type": "text", "id": "title", "label": "Step title" },
        { "type": "textarea", "id": "instruction", "label": "Instruction", "info": "40-100 words. Answer 'what do I do now?' first. Leave blank until approved copy exists." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        { "type": "text", "id": "asset_id", "label": "Asset ID", "info": "Shown in the placeholder so the photographer knows which shot this is." },
        { "type": "textarea", "id": "tip", "label": "Tip" },
        { "type": "select", "id": "warning_level", "label": "Warning level",
          "options": [ {"value":"info","label":"Information"}, {"value":"caution","label":"Caution"}, {"value":"critical","label":"Critical"} ],
          "default": "caution" },
        { "type": "text", "id": "warning_title", "label": "Warning title" },
        { "type": "textarea", "id": "warning", "label": "Warning" },
        { "type": "textarea", "id": "why", "label": "Why this matters", "info": "Technical detail beyond ~140 words belongs here, not in the instruction." }
      ]
    }
  ]
}
{% endschema %}
