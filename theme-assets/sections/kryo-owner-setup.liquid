{%- comment -%}
  KRYO Setup — one scrollable page, five parts  ·  /pages/kryo-setup
  Brief: "KRYO SETUP UX REVISION".

  This replaces the 24-screen wizard with a single scrollable guide. A confident owner reads
  only the quick instructions and scrolls; a novice opens "Show detailed instructions" and gets
  every piece of technical detail the wizard used to hold. Critical warnings and the stop
  criteria are NEVER inside an accordion.

  Unchanged on purpose: the safety gate and its state contract, progress persistence (migrated,
  not reset), Help/WhatsApp support, the owner header, the KRYO design tokens, analytics.
{%- endcomment -%}

{{ 'kryo-owner.css' | asset_url | stylesheet_tag }}

<div class="kryo-owner kryo-su" data-kryo-setup
     data-hub="{{ section.settings.hub_url }}"
     data-safety-url="{{ section.settings.safety_url }}"
     data-wa="{{ section.settings.whatsapp_url }}"
     data-safety-version="{{ section.settings.safety_version }}"
     data-terms-version="{{ section.settings.terms_version }}"
     data-legacy-steps="{{ section.settings.legacy_total_steps }}"
     data-gate-cta="{{ section.settings.gate_cta | escape }}"
     data-reack-cta="{{ section.settings.reack_cta | escape }}"
     data-reack-heading="{{ section.settings.reack_heading | escape }}"
     data-err-full="{{ section.settings.err_full | escape }}"
     data-err-ack="{{ section.settings.err_ack | escape }}"
     data-mark-done="{{ section.settings.mark_done | escape }}"
     data-marked="{{ section.settings.marked | escape }}"
     data-continue-label="{{ section.settings.continue_label | escape }}"
     data-end-done-heading="{{ section.settings.end_done_heading | escape }}"
     data-end-done-body="{{ section.settings.end_done_body | escape }}">

  {%- comment -%}
    Owner header. The logo falls back to the theme's own `settings.logo`, so the owner
    pages carry the same mark as the rest of the site and follow it if it is ever changed.
  {%- endcomment -%}
  {%- assign owner_logo = section.settings.logo | default: settings.logo -%}
  <header class="kryo-su__bar">
    <div class="kryo-su__barrow">
      <a class="kryo-su__brand" href="{{ section.settings.hub_url }}" aria-label="Everest Labs owner guide">
        {%- if owner_logo != blank -%}
          {{ owner_logo | image_url: width: 420 | image_tag: alt: 'Everest Labs', class: 'kryo-su__logo', loading: 'eager' }}
        {%- else -%}
          <span class="kryo-su__wordmark">EVEREST LABS</span>
        {%- endif -%}
      </a>
    </div>
    {%- comment -%} Five scroll-to links. Horizontally scrollable at 320px. {%- endcomment -%}
    <nav class="kryo-su__chips" data-kryo-chips aria-label="{{ section.settings.nav_heading }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'chapter' -%}
          <a class="kryo-su__chip" href="#{{ block.settings.anchor }}"
             data-kryo-chip="{{ block.settings.anchor }}" data-kryo-jump>
            <span class="kryo-su__chipnum">{{ block.settings.number }}</span>
            <span>{{ block.settings.nav_label | default: block.settings.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </header>

  {%- comment -%} ===== GATE — unchanged logic. One acknowledgement, ever. ===== {%- endcomment -%}
  <section class="kryo-su__gate" data-kryo-gate hidden>
    <div class="kryo-su__wrap">
      <p class="kryo-su__eyebrow">{{ section.settings.gate_eyebrow }}</p>
      <h1 class="kryo-su__h1" tabindex="-1" data-kryo-gate-heading>{{ section.settings.gate_heading }}</h1>
      <div class="kryo-owner__note kryo-owner__note--critical">
        <p class="kryo-owner__note__title">{{ section.settings.gate_lead_title }}</p>
        {{ section.settings.gate_lead }}
      </div>
      <p class="kryo-su__body">{{ section.settings.gate_body }}</p>
      <p class="kryo-su__body kryo-su__gateconfirm">{{ section.settings.gate_confirm_lead }}</p>
      <ul class="kryo-su__gatelist">
        {%- assign confirms = section.settings.gate_confirms | split: '|' -%}
        {%- for line in confirms -%}
          <li><span class="kryo-su__gatetick" aria-hidden="true"></span>{{ line | strip }}</li>
        {%- endfor -%}
      </ul>
      <p class="kryo-su__body" data-kryo-gate-reack hidden>{{ section.settings.gate_reack_body }}</p>

      <form data-kryo-gate-form novalidate>
        <div data-kryo-gate-fields>
          <label class="kryo-su__f"><span>{{ section.settings.f_name }}</span>
            <input type="text" name="name" autocomplete="name" enterkeyhint="next"></label>
          <label class="kryo-su__f"><span>{{ section.settings.f_email }}</span>
            <input type="email" name="email" autocomplete="email" inputmode="email" enterkeyhint="done"></label>
        </div>
        <label class="kryo-su__check"><input type="checkbox" name="accept"><span>{{ section.settings.gate_accept }}</span></label>
        <p class="kryo-su__err" data-kryo-gate-err hidden role="alert"></p>
        <button type="button" class="kryo-su__cta" data-kryo-gate-submit>{{ section.settings.gate_cta }}</button>
        <a class="kryo-su__opt kryo-su__opt--link kryo-su__gatesecondary" href="{{ section.settings.safety_url }}">{{ section.settings.gate_link }}</a>
      </form>
    </div>
  </section>

  {%- comment -%} ===== THE GUIDE — one scroll ===== {%- endcomment -%}
  <main class="kryo-su__guide" data-kryo-guide hidden>

    {%- comment -%} ---- Overview ---- {%- endcomment -%}
    <section class="kryo-su__wrap kryo-su__overview" id="overview">
      <p class="kryo-su__eyebrow">{{ section.settings.start_eyebrow }}</p>
      <h1 class="kryo-su__h1" tabindex="-1">{{ section.settings.start_heading }}</h1>
      <p class="kryo-su__body">{{ section.settings.start_body }}</p>

      <ol class="kryo-su__toc">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chapter' -%}
            <li><a class="kryo-su__tocrow" href="#{{ block.settings.anchor }}" data-kryo-toc="{{ block.settings.anchor }}">
              <span class="kryo-su__tocnum" aria-hidden="true"></span>
              <span class="kryo-su__toctitle">{{ block.settings.title }}</span>
              <span class="kryo-su__tocstate" data-kryo-tocstate="{{ block.settings.anchor }}" aria-hidden="true"></span>
            </a></li>
          {%- endif -%}
        {%- endfor -%}
      </ol>

      <button type="button" class="kryo-su__cta kryo-su__cta--resume" data-kryo-resume hidden></button>
      <button type="button" class="kryo-su__opt kryo-su__opt--help" data-kryo-help-open
              aria-label="{{ section.settings.help_aria }}">{{ section.settings.help_label_long }}</button>

      {%- comment -%} ---- Don't miss these — never collapsed ---- {%- endcomment -%}
      {%- assign has_rules = false -%}
      {%- for rb in section.blocks -%}
        {%- if rb.type == 'rule' -%}{%- assign has_rules = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_rules -%}
      <div class="kryo-su__rules">
        <p class="kryo-su__ruleshead">{{ section.settings.rules_heading }}</p>
        <ol class="kryo-su__rulelist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'rule' -%}
              <li {{ block.shopify_attributes }}>
                <span class="kryo-su__rulenum" aria-hidden="true"></span>
                <span><strong>{{ block.settings.title }}</strong><br>{{ block.settings.body }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
      {%- endif -%}

      {%- comment -%}
        Know the parts — only rendered if it still has content. The components are now
        identified in the first chapter, so this accordion is empty and stays hidden.
      {%- endcomment -%}
      {%- assign has_parts = false -%}
      {%- for pb in section.blocks -%}
        {%- if pb.type == 'part' -%}{%- assign has_parts = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_parts or section.settings.parts_image != blank -%}
      <details class="kryo-su__acc kryo-su__acc--parts">
        <summary><span>{{ section.settings.parts_heading }}</span></summary>
        <div class="kryo-su__accbody">
          {%- if section.settings.parts_image != blank -%}
            {%- assign parts_alt = section.settings.parts_image_alt | default: section.settings.parts_heading -%}
            <button type="button" class="kryo-su__imgbtn" data-kryo-zoom
                    data-src="{{ section.settings.parts_image | image_url: width: 1600 }}"
                    aria-label="{{ section.settings.zoom_aria }}">
              {%- assign pim = section.settings.parts_image -%}
              <img src="{{ pim | image_url: width: 1200 }}"
     srcset="{{ pim | image_url: width: 430 }} 430w, {{ pim | image_url: width: 860 }} 860w, {{ pim | image_url: width: 1200 }} 1200w"
     sizes="(min-width: 990px) 860px, 100vw"
     alt="{{ parts_alt | escape }}" class="kryo-su__img"
     width="{{ pim.width }}" height="{{ pim.height }}" loading="lazy" decoding="async">
              <span class="kryo-su__zoomhint" aria-hidden="true">{{ section.settings.zoom_hint }}</span>
            </button>
          {%- endif -%}
          <dl class="kryo-su__glossary">
            {%- for block in section.blocks -%}
              {%- if block.type == 'part' -%}
                <div {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.term }}</dt>
                  <dd>{{ block.settings.definition }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </div>
      </details>
      {%- endif -%}
    </section>

    {%- comment -%} ---- The chapters ---- {%- endcomment -%}
    {%- assign chapter_total = 0 -%}
    {%- for cb in section.blocks -%}
      {%- if cb.type == 'chapter' -%}{%- assign chapter_total = chapter_total | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'chapter' -%}
        <section class="kryo-su__ch" id="{{ block.settings.anchor }}"
                 data-kryo-ch="{{ block.settings.anchor }}" {{ block.shopify_attributes }}>
          <div class="kryo-su__wrap">
            <p class="kryo-su__eyebrow">
              <span class="kryo-su__chbadge">{{ block.settings.number }}</span>{{ section.settings.chapter_word }} {{ block.settings.number }} {{ section.settings.of_word }} {{ chapter_total }}
              <span class="kryo-su__chdone" data-kryo-chdone hidden>{{ section.settings.marked }}</span>
            </p>
            <h2 class="kryo-su__h2" tabindex="-1">{{ block.settings.title }}</h2>
            <p class="kryo-su__purpose">{{ block.settings.purpose }}</p>

            {%- comment -%} Media: full width, stacked, lazy below the first viewport. {%- endcomment -%}
            {%- assign has_media = false -%}
            {%- if block.settings.image_1 != blank or block.settings.slot_1 != blank -%}{%- assign has_media = true -%}{%- endif -%}
            {%- if block.settings.image_2 != blank or block.settings.slot_2 != blank -%}{%- assign has_media = true -%}{%- endif -%}
            {%- if block.settings.image_3 != blank or block.settings.slot_3 != blank -%}{%- assign has_media = true -%}{%- endif -%}
            {%- if block.settings.image_4 != blank or block.settings.slot_4 != blank -%}{%- assign has_media = true -%}{%- endif -%}
            {%- if has_media -%}
              <div class="kryo-su__media">
                {%- for i in (1..4) -%}
                  {%- case i -%}
                    {%- when 1 -%}{%- assign im = block.settings.image_1 -%}{%- assign ia = block.settings.alt_1 -%}{%- assign slot = block.settings.slot_1 -%}
                    {%- when 2 -%}{%- assign im = block.settings.image_2 -%}{%- assign ia = block.settings.alt_2 -%}{%- assign slot = block.settings.slot_2 -%}
                    {%- when 3 -%}{%- assign im = block.settings.image_3 -%}{%- assign ia = block.settings.alt_3 -%}{%- assign slot = block.settings.slot_3 -%}
                    {%- when 4 -%}{%- assign im = block.settings.image_4 -%}{%- assign ia = block.settings.alt_4 -%}{%- assign slot = block.settings.slot_4 -%}
                  {%- endcase -%}
                  {%- if im != blank -%}
                    {%- assign im_alt = ia | default: block.settings.title -%}
                    <button type="button" class="kryo-su__imgbtn" data-kryo-zoom
                            data-src="{{ im | image_url: width: 1600 }}" aria-label="{{ section.settings.zoom_aria }}">
                      <img src="{{ im | image_url: width: 1200 }}"
     srcset="{{ im | image_url: width: 430 }} 430w, {{ im | image_url: width: 860 }} 860w, {{ im | image_url: width: 1200 }} 1200w"
     sizes="(min-width: 990px) 860px, 100vw"
     alt="{{ im_alt | escape }}" class="kryo-su__img"
     width="{{ im.width }}" height="{{ im.height }}" loading="eager" decoding="async">
                      <span class="kryo-su__zoomhint" aria-hidden="true">{{ section.settings.zoom_hint }}</span>
                    </button>
                  {%- elsif slot != blank -%}
                    <div class="kryo-owner__placeholder kryo-su__ph">
                      <strong>IMAGE REQUIRED</strong>
                      <span>{{ block.settings.title }}</span>
                      <span>{{ slot }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- comment -%}
              Quick instructions are their own blocks so each line is editable in the theme
              editor and can carry its own explanation. The instruction TEXT is always visible;
              only the extra detail collapses, so nothing safety-relevant is hidden by default.
              Falls back to the legacy richtext if a chapter has no instruction blocks.
            {%- endcomment -%}
            {%- assign ch_anchor = block.settings.anchor -%}
            {%- assign quick_count = 0 -%}
            {%- for ib in section.blocks -%}
              {%- if ib.type == 'instruction' and ib.settings.chapter == ch_anchor -%}
                {%- assign quick_count = quick_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if quick_count > 0 -%}
              <div class="kryo-su__quick">
                {%- for ib in section.blocks -%}
                  {%- if ib.type == 'instruction' and ib.settings.chapter == ch_anchor -%}
                    {%- comment -%}
                      A newly uploaded file can exist in Files while the storefront has not yet
                      indexed its shopify://shop_images reference — image_url then returns nil and
                      the picture silently disappears. image_src is a direct-URL fallback for that.
                    {%- endcomment -%}
                    {%- assign qsrc = '' -%}
                    {%- if ib.settings.image != blank -%}
                      {%- assign qsrc = ib.settings.image | image_url: width: 1200 -%}
                    {%- endif -%}
                    {%- if qsrc == blank and ib.settings.image_src != blank -%}
                      {%- assign qsrc = ib.settings.image_src -%}
                    {%- endif -%}
                    {%- assign has_detail = false -%}
                    {%- if ib.settings.detail != blank or qsrc != blank or ib.settings.slot != blank -%}
                      {%- assign has_detail = true -%}
                    {%- endif -%}
                    {%- if has_detail -%}
                      <details class="kryo-su__qa" {{ ib.shopify_attributes }}>
                        <summary>
                          <span class="kryo-su__qadot" aria-hidden="true"></span>
                          <span class="kryo-su__qatext">{{ ib.settings.text }}</span>
                          <span class="kryo-su__qamark" aria-hidden="true"></span>
                        </summary>
                        <div class="kryo-su__qabody">
                          {%- comment -%}
                            Image before the explanation. loading="lazy" means a closed row
                            costs nothing — the file is only fetched once the row is opened.
                          {%- endcomment -%}
                          {%- if qsrc != blank -%}
                            {%- assign qa_alt = ib.settings.image_alt | default: ib.settings.text -%}
                            <button type="button" class="kryo-su__imgbtn kryo-su__qaimg" data-kryo-zoom
                                    data-src="{{ qsrc }}" aria-label="{{ section.settings.zoom_aria }}">
                              <img src="{{ qsrc }}" alt="{{ qa_alt | escape }}" class="kryo-su__img"
                                   loading="lazy" decoding="async">
                              <span class="kryo-su__zoomhint" aria-hidden="true">{{ section.settings.zoom_hint }}</span>
                            </button>
                          {%- elsif ib.settings.slot != blank -%}
                            <div class="kryo-owner__placeholder kryo-su__ph kryo-su__qaimg">
                              <strong>IMAGE REQUIRED</strong>
                              <span>{{ ib.settings.text | truncate: 48 }}</span>
                              <span>{{ ib.settings.slot }}</span>
                            </div>
                          {%- endif -%}
                          {{ ib.settings.detail }}
                        </div>
                      </details>
                    {%- elsif ib.settings.text != blank -%}
                      <p class="kryo-su__qa kryo-su__qa--plain" {{ ib.shopify_attributes }}>
                        <span class="kryo-su__qadot" aria-hidden="true"></span>
                        <span class="kryo-su__qatext">{{ ib.settings.text }}</span>
                      </p>
                    {%- endif -%}
                    {%- if ib.settings.checklist != blank -%}
                      <div class="kryo-su__qacheck">{{ ib.settings.checklist }}</div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- elsif block.settings.quick != blank -%}
              <div class="kryo-su__quick">{{ block.settings.quick }}</div>
            {%- endif -%}

            {%- comment -%} Critical warnings sit OUTSIDE the accordion, always. {%- endcomment -%}
            {%- if block.settings.critical != blank -%}
              <div class="kryo-owner__note kryo-owner__note--critical">
                <p class="kryo-owner__note__title">{{ section.settings.lbl_critical }}</p>
                {{ block.settings.critical }}
              </div>
            {%- endif -%}

            {%- comment -%} Always-visible extra (e.g. the stop criteria). Never collapsed. {%- endcomment -%}
            {%- if block.settings.always_visible != blank -%}
              <div class="kryo-owner__note kryo-owner__note--{{ block.settings.always_level }}">
                {%- if block.settings.always_title != blank -%}
                  <p class="kryo-owner__note__title">{{ block.settings.always_title }}</p>
                {%- endif -%}
                {{ block.settings.always_visible }}
              </div>
            {%- endif -%}

            {%- assign has_detail_media = false -%}
            {%- if block.settings.detail_image_1 != blank or block.settings.detail_image_2 != blank -%}
              {%- assign has_detail_media = true -%}
            {%- endif -%}
            {%- if block.settings.detail != blank or has_detail_media -%}
              <details class="kryo-su__acc" data-kryo-detail="{{ block.settings.anchor }}">
                <summary><span>{{ section.settings.detail_label }}</span></summary>
                <div class="kryo-su__accbody">
                  {{ block.settings.detail }}
                  {%- comment -%} Secondary images live inside the dropdown, one per row. {%- endcomment -%}
                  {%- if has_detail_media -%}
                    <div class="kryo-su__media kryo-su__media--detail">
                      {%- for j in (1..2) -%}
                        {%- case j -%}
                          {%- when 1 -%}{%- assign dim = block.settings.detail_image_1 -%}{%- assign dia = block.settings.detail_alt_1 -%}
                          {%- when 2 -%}{%- assign dim = block.settings.detail_image_2 -%}{%- assign dia = block.settings.detail_alt_2 -%}
                        {%- endcase -%}
                        {%- if dim != blank -%}
                          {%- assign d_alt = dia | default: block.settings.title -%}
                          <button type="button" class="kryo-su__imgbtn" data-kryo-zoom
                                  data-src="{{ dim | image_url: width: 1600 }}" aria-label="{{ section.settings.zoom_aria }}">
                            <img src="{{ dim | image_url: width: 1200 }}"
     srcset="{{ dim | image_url: width: 430 }} 430w, {{ dim | image_url: width: 860 }} 860w, {{ dim | image_url: width: 1200 }} 1200w"
     sizes="(min-width: 990px) 860px, 100vw"
     alt="{{ d_alt | escape }}" class="kryo-su__img"
     width="{{ dim.width }}" height="{{ dim.height }}" loading="lazy" decoding="async">
                            <span class="kryo-su__zoomhint" aria-hidden="true">{{ section.settings.zoom_hint }}</span>
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}

            <div class="kryo-su__chfoot">
              <button type="button" class="kryo-su__mark" data-kryo-mark="{{ block.settings.anchor }}">
                {{ section.settings.mark_done }}
              </button>
              <div class="kryo-su__chlinks">
                {%- comment -%} Help lives here now the sticky bar carries the section links —
                  it is reachable from every part, where someone actually gets stuck. {%- endcomment -%}
                <button type="button" class="kryo-su__sublink" data-kryo-help-open>{{ section.settings.help_label_long }}</button>
                {%- if block.settings.next_anchor != blank -%}
                  <a class="kryo-su__sublink kryo-su__sublink--next" href="#{{ block.settings.next_anchor }}" data-kryo-jump>
                    {{ section.settings.next_word }} {{ block.settings.next_label }} <span aria-hidden="true">&#8594;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}

    <section class="kryo-su__wrap kryo-su__end">
      <div class="kryo-su__tick" data-kryo-endtick aria-hidden="true" hidden></div>
      <h2 class="kryo-su__h2" data-kryo-endheading>{{ section.settings.end_heading }}</h2>
      <p class="kryo-su__body" data-kryo-endbody>{{ section.settings.end_body }}</p>
      <a class="kryo-su__opt kryo-su__opt--link" href="{{ section.settings.hub_url }}">{{ section.settings.end_cta }}</a>
    </section>
  </main>

  {%- comment -%} ===== Sheets ===== {%- endcomment -%}
  <div class="kryo-su__sheet" data-kryo-sheet="help" hidden>
    <div class="kryo-su__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.help_heading }}">
      <div class="kryo-su__grab" aria-hidden="true"></div>
      <h2 class="kryo-su__h3">{{ section.settings.help_heading }}</h2>
      <div class="kryo-su__opts">
        {%- assign topics = section.settings.help_topics | split: ',' -%}
        {%- for t in topics -%}
          <button type="button" class="kryo-su__opt" data-kryo-topic="{{ t | strip | escape }}">{{ t | strip }}</button>
        {%- endfor -%}
      </div>
      <p class="kryo-su__meta" data-kryo-help-ctx></p>
      <a class="kryo-su__opt kryo-su__opt--link" href="{{ section.settings.safety_url }}">{{ section.settings.help_safety }}</a>
      <button type="button" class="kryo-su__alt" data-kryo-sheet-close>{{ section.settings.close_label }}</button>
    </div>
  </div>

  <div class="kryo-su__zoom" data-kryo-zoomview hidden>
    <button type="button" class="kryo-su__zoom__close" data-kryo-zoom-close aria-label="{{ section.settings.close_label }}">&#10005;</button>
    <img alt="" data-kryo-zoom-img>
  </div>
</div>

{% style %}
  /* --head is the full sticky header: logo row + the section-link row. */
  .kryo-su { --bar:56px; --head:114px; padding:0; }
  .kryo-su__sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

  /* ---- Header: logo row + five section links ---- */
  .kryo-su__bar { position:sticky; top:0; z-index:40; background:var(--kryo-white);
    border-bottom:1px solid var(--kryo-border); }
  .kryo-su__barrow { height:var(--bar); display:flex; align-items:center; padding:0 20px; }
  .kryo-su__brand { display:inline-flex; align-items:center; min-height:48px; min-width:48px; text-decoration:none; }
  .kryo-su__logo { height:26px; width:auto; display:block; }
  .kryo-su__wordmark { font:700 13px/1 var(--kryo-font-body); letter-spacing:.14em; color:var(--kryo-text); }

  .kryo-su__chips { display:flex; gap:6px; padding:0 20px 10px; overflow-x:auto;
    scrollbar-width:none; -webkit-overflow-scrolling:touch; scroll-behavior:smooth; }
  .kryo-su__chips::-webkit-scrollbar { display:none; }
  .kryo-su__chip { flex:0 0 auto; display:inline-flex; align-items:center; gap:7px; min-height:48px;
    padding:0 14px; border-radius:999px; border:1px solid var(--kryo-border);
    background:var(--kryo-white); color:var(--kryo-text-secondary); text-decoration:none;
    font:600 14px/1 var(--kryo-font-body); white-space:nowrap; }
  .kryo-su__chipnum { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px;
    border-radius:999px; background:var(--kryo-surface); color:var(--kryo-text-secondary); font-size:11px; }
  .kryo-su__chip[data-state="current"] { background:var(--kryo-ink); border-color:var(--kryo-ink); color:#fff; }
  .kryo-su__chip[data-state="current"] .kryo-su__chipnum { background:rgba(255,255,255,.22); color:#fff; }
  .kryo-su__chip[data-state="done"] { border-color:var(--kryo-blue); color:var(--kryo-blue-strong); }
  .kryo-su__chip[data-state="done"] .kryo-su__chipnum { background:var(--kryo-blue); color:#fff; font-size:0; }
  .kryo-su__chip[data-state="done"] .kryo-su__chipnum::after { content:'\2713'; font-size:11px; }

  .kryo-su__opt--help { width:100%; justify-content:center; color:var(--kryo-text);
    margin-bottom:18px; cursor:pointer; }
  .kryo-su__chlinks { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .kryo-su__sublink { min-height:48px; padding:0; border:0; background:none; cursor:pointer;
    display:inline-flex; align-items:center; gap:6px; text-decoration:none;
    font:600 15px/1 var(--kryo-font-body); color:var(--kryo-text-secondary); }
  .kryo-su__sublink--next { color:var(--kryo-blue); }

  /* ---- Layout ---- */
  .kryo-su__wrap { padding:24px 20px; max-width:640px; margin:0 auto; }
  .kryo-su__guide[hidden], .kryo-su__gate[hidden] { display:none; }
  .kryo-su__ch { scroll-margin-top:var(--head); border-top:1px solid var(--kryo-border); }
  .kryo-su__overview { scroll-margin-top:var(--head); }
  .kryo-su__eyebrow { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
    font:700 11px/1.3 var(--kryo-font-body); letter-spacing:.12em; text-transform:uppercase;
    color:var(--kryo-text-secondary); margin:0 0 10px; }
  .kryo-su__chbadge { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px;
    border-radius:999px; background:var(--kryo-ink); color:#fff; font-size:11px; letter-spacing:0; }
  .kryo-su__chdone { color:var(--kryo-blue-strong); }
  .kryo-su__chdone[hidden] { display:none; }
  .kryo-su__h1 { font-family:var(--kryo-font-heading); font-size:30px; line-height:1.12; font-weight:700;
    letter-spacing:-.02em; color:var(--kryo-text); margin:0 0 16px; }
  .kryo-su__h2 { font-family:var(--kryo-font-heading); font-size:26px; line-height:1.15; font-weight:700;
    letter-spacing:-.02em; color:var(--kryo-text); margin:0 0 10px; }
  .kryo-su__h3 { font-family:var(--kryo-font-heading); font-size:20px; font-weight:700; margin:0 0 14px; }
  .kryo-su__h1:focus, .kryo-su__h2:focus { outline:none; }
  .kryo-su__body { font-size:16px; line-height:1.5; color:var(--kryo-text-secondary); margin:0 0 16px; }
  .kryo-su__body p { margin:0 0 12px; font-size:16px; line-height:1.5; }
  .kryo-su__purpose { font-size:16px; line-height:1.5; color:var(--kryo-text-secondary); margin:0 0 18px; }
  .kryo-su__meta { font-size:14px; color:var(--kryo-text-tertiary); margin:0 0 14px; }
  .kryo-su .kryo-owner__note { margin:0 0 18px; }

  /* ---- Overview navigator ---- */
  /* Numbers come from CSS counters, not a Liquid counter: the block list is mixed
     (rules + parts + chapters) so forloop.index cannot be used, and a running assign
     is fragile. The counter is always right regardless of block order. */
  .kryo-su__toc { list-style:none; margin:0 0 22px; padding:0; counter-reset:kryotoc; }
  .kryo-su__tocnum::before { counter-increment:kryotoc; content:counter(kryotoc); }
  .kryo-su__tocrow { display:flex; align-items:center; gap:12px; min-height:56px; padding:10px 4px;
    border-bottom:1px solid var(--kryo-border); text-decoration:none;
    font:600 16px/1.3 var(--kryo-font-body); color:var(--kryo-text); }
  .kryo-su__tocnum { flex:0 0 auto; width:26px; height:26px; border-radius:999px; background:var(--kryo-surface);
    display:inline-flex; align-items:center; justify-content:center; font-size:12px; color:var(--kryo-text-secondary); }
  .kryo-su__toctitle { flex:1; }
  .kryo-su__tocstate { flex:0 0 auto; width:20px; height:20px; border-radius:999px;
    display:inline-flex; align-items:center; justify-content:center; font-size:12px; color:#fff; }
  .kryo-su__tocrow[data-state="done"] .kryo-su__tocstate { background:var(--kryo-blue); }
  .kryo-su__tocrow[data-state="done"] .kryo-su__tocstate::after { content:'\2713'; }
  .kryo-su__tocrow[data-state="done"] .kryo-su__tocnum { background:var(--kryo-blue-bg); color:var(--kryo-blue-strong); }
  .kryo-su__cta--resume { margin:0 0 26px; }

  /* ---- Don't miss these ---- */
  .kryo-su__rules { background:var(--kryo-surface); border-radius:16px; padding:18px 18px 6px; margin:0 0 18px; }
  .kryo-su__ruleshead { font:700 11px/1.2 var(--kryo-font-body); letter-spacing:.12em; text-transform:uppercase;
    color:var(--kryo-text); margin:0 0 14px; }
  .kryo-su__rulelist { list-style:none; margin:0; padding:0; counter-reset:kryorule; }
  .kryo-su__rulenum::before { counter-increment:kryorule; content:counter(kryorule); }
  .kryo-su__rulelist li { display:flex; gap:12px; margin:0 0 14px;
    font-size:15px; line-height:1.45; color:var(--kryo-text-secondary); }
  .kryo-su__rulelist strong { color:var(--kryo-text); font-weight:700; }
  .kryo-su__rulenum { flex:0 0 auto; width:22px; height:22px; border-radius:999px; background:var(--kryo-blue);
    color:#fff; display:inline-flex; align-items:center; justify-content:center; font:700 11px/1 var(--kryo-font-body); }

  /* ---- Quick instructions ---- */
  .kryo-su__quick { margin:0 0 20px; border-top:1px solid var(--kryo-border); }
  .kryo-su__qa { border-bottom:1px solid var(--kryo-border); }
  .kryo-su__qa summary, .kryo-su__qa--plain { display:flex; align-items:flex-start; gap:12px;
    min-height:56px; padding:14px 0; margin:0; list-style:none; cursor:pointer;
    font-size:16px; line-height:1.45; color:var(--kryo-text); }
  .kryo-su__qa--plain { cursor:default; }
  .kryo-su__qa summary::-webkit-details-marker { display:none; }
  .kryo-su__qadot { flex:0 0 auto; width:7px; height:7px; margin-top:8px; border-radius:999px;
    background:var(--kryo-blue); }
  .kryo-su__qatext { flex:1; }
  /* Only rows that actually carry an explanation show the affordance. */
  .kryo-su__qamark { flex:0 0 auto; position:relative; width:20px; height:20px; margin-top:2px; }
  .kryo-su__qamark::before, .kryo-su__qamark::after { content:''; position:absolute; left:4px; top:9px;
    width:12px; height:2px; border-radius:2px; background:var(--kryo-text-secondary);
    transition:transform 180ms cubic-bezier(.2,.7,.3,1); }
  .kryo-su__qamark::after { transform:rotate(90deg); }
  .kryo-su__qa[open] .kryo-su__qamark::after { transform:rotate(0deg); }
  .kryo-su__qacheck { padding:0 0 16px 19px; }
  .kryo-su__qacheck ul { list-style:none; margin:0; padding:0; }
  .kryo-su__qacheck li { position:relative; padding:0 0 0 24px; margin:0 0 8px;
    font-size:15px; line-height:1.45; color:var(--kryo-text); }
  .kryo-su__qacheck li::before { content:'\2713'; position:absolute; left:0; top:0;
    color:var(--kryo-blue-strong); font-weight:700; }
  .kryo-su__qacheck p { font-size:15px; line-height:1.5; color:var(--kryo-text); margin:0 0 8px; }
  .kryo-su__qabody { padding:0 0 18px 19px; animation:kryoAccIn 200ms cubic-bezier(.2,.7,.3,1) both; }
  .kryo-su__qaimg { margin:0 0 12px; border-radius:12px; }
  /* Media inside a dropdown must still be full width on mobile. The panel's own
     horizontal padding was shrinking it to 316px of 390px. */
  .kryo-su__accbody .kryo-su__media { margin-left:-16px; margin-right:-16px; }
  .kryo-su__qabody .kryo-su__qaimg { margin-left:-19px; margin-right:0; }
  .kryo-su__qaimg .kryo-su__img, .kryo-su__ph.kryo-su__qaimg { border-radius:12px; max-height:46vh; }
  .kryo-su__qabody p { font-size:15px; line-height:1.55; color:var(--kryo-text-secondary); margin:0 0 10px; }
  .kryo-su__qabody p:last-child { margin-bottom:0; }
  .kryo-su__qabody ul, .kryo-su__qabody ol { margin:0 0 10px; padding-left:18px; }
  .kryo-su__qabody li { font-size:15px; line-height:1.55; color:var(--kryo-text-secondary); margin-bottom:6px; }
  /* legacy richtext fallback */
  .kryo-su__quick ul, .kryo-su__quick ol { margin:0; padding:0; list-style:none; }
  .kryo-su__quick li { position:relative; padding:14px 0 14px 19px;
    border-bottom:1px solid var(--kryo-border); font-size:16px; line-height:1.45; color:var(--kryo-text); }
  .kryo-su__quick li::before { content:''; position:absolute; left:0; top:22px; width:7px; height:7px;
    border-radius:999px; background:var(--kryo-blue); }

  /* ---- Media ---- */
  .kryo-su__media { display:flex; flex-direction:column; gap:12px; margin:0 0 20px; }
  .kryo-su__media--detail { margin:14px 0 0; }
  .kryo-su__imgbtn { position:relative; display:block; width:100%; padding:0; border:0; background:none;
    cursor:zoom-in; border-radius:14px; overflow:hidden; }
  .kryo-su__img { width:100%; height:auto !important; max-height:62vh; object-fit:contain; display:block;
    background:var(--kryo-surface); border-radius:14px; }
  .kryo-su__ph { width:100%; aspect-ratio:4/3; border-radius:14px; margin:0; }
  .kryo-su__zoomhint { position:absolute; right:10px; bottom:10px; padding:6px 10px; border-radius:999px;
    background:rgba(23,26,28,.72); color:#fff; font:600 11px/1 var(--kryo-font-body);
    letter-spacing:.04em; text-transform:uppercase; pointer-events:none; }

  /* ---- Accordions ---- */
  .kryo-su__acc { border:1px solid var(--kryo-border); border-radius:14px; margin:0 0 20px; overflow:hidden; }
  .kryo-su__acc summary { display:flex; align-items:center; justify-content:space-between; gap:12px;
    min-height:56px; padding:0 16px; cursor:pointer; list-style:none;
    font:600 16px/1.3 var(--kryo-font-body); color:var(--kryo-text); }
  .kryo-su__acc summary::-webkit-details-marker { display:none; }
  .kryo-su__acc summary::after { content:'+'; flex:0 0 auto; font-size:20px; color:var(--kryo-text-secondary); }
  .kryo-su__acc[open] summary::after { content:'\2212'; }
  .kryo-su__accbody { padding:4px 16px 18px; animation:kryoAccIn 200ms cubic-bezier(.2,.7,.3,1) both; }
  @keyframes kryoAccIn { from { opacity:0; transform:translateY(-4px) } to { opacity:1; transform:none } }
  .kryo-su__accbody p { font-size:15px; line-height:1.55; color:var(--kryo-text-secondary); margin:0 0 12px; }
  .kryo-su__accbody ul, .kryo-su__accbody ol { margin:0 0 14px; padding-left:20px; }
  .kryo-su__accbody li { font-size:15px; line-height:1.55; color:var(--kryo-text-secondary); margin-bottom:8px; }
  .kryo-su__accbody strong { color:var(--kryo-text); }
  .kryo-su__acc--parts { background:var(--kryo-white); }
  .kryo-su__glossary { margin:0; }
  .kryo-su__glossary div { padding:12px 0; border-bottom:1px solid var(--kryo-border); }
  .kryo-su__glossary div:last-child { border-bottom:0; }
  .kryo-su__glossary dt { font:700 15px/1.3 var(--kryo-font-body); color:var(--kryo-text); margin:0 0 4px; }
  .kryo-su__glossary dd { margin:0; font-size:15px; line-height:1.5; color:var(--kryo-text-secondary); }

  /* ---- Chapter footer ---- */
  .kryo-su__chfoot { display:flex; flex-direction:column; gap:6px; }
  .kryo-su__mark { width:100%; min-height:52px; border:1px solid var(--kryo-border-strong); border-radius:999px;
    background:var(--kryo-white); color:var(--kryo-text); font:600 16px/1.2 var(--kryo-font-body); cursor:pointer;
    transition:background 150ms ease, color 150ms ease, border-color 150ms ease; }
  .kryo-su__mark[data-state="done"] { background:var(--kryo-blue-bg); border-color:var(--kryo-blue-bg);
    color:var(--kryo-blue-strong); }

  .kryo-su__cta { width:100%; min-height:56px; padding:0 18px; border:0; border-radius:999px;
    background:var(--kryo-ink); color:#fff; font:600 17px/1.2 var(--kryo-font-body); cursor:pointer;
    transition:transform 100ms ease, opacity 100ms ease; }
  .kryo-su__cta:active { transform:scale(.985); opacity:.9; }
  .kryo-su__alt { width:100%; min-height:48px; border:0; background:none; color:var(--kryo-text-secondary);
    font:600 15px/1 var(--kryo-font-body); cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
  .kryo-su__end { text-align:center; border-top:1px solid var(--kryo-border); padding-bottom:56px; }
  .kryo-su__tick { width:52px; height:52px; margin:0 auto 16px; border-radius:999px;
    background:var(--kryo-blue-bg); position:relative; }
  .kryo-su__tick[hidden] { display:none; }
  .kryo-su__tick::after { content:'\2713'; position:absolute; inset:0; display:flex; align-items:center;
    justify-content:center; color:var(--kryo-blue-strong); font-size:24px; font-weight:700; }

  /* ---- Sheets ---- */
  .kryo-su__sheet { position:fixed; inset:0; z-index:60; background:rgba(23,26,28,.5); display:flex; align-items:flex-end; }
  .kryo-su__sheet[hidden] { display:none; }
  .kryo-su__panel { background:var(--kryo-white); width:100%; max-height:86vh; overflow-y:auto;
    padding:10px 20px calc(20px + env(safe-area-inset-bottom)); border-radius:20px 20px 0 0;
    animation:kryoSheetIn 200ms cubic-bezier(.2,.7,.3,1) both; }
  @keyframes kryoSheetIn { from { transform:translateY(18px); opacity:0 } to { transform:none; opacity:1 } }
  .kryo-su__grab { width:38px; height:4px; border-radius:999px; background:var(--kryo-border); margin:0 auto 14px; }
  .kryo-su__navrow { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%;
    min-height:56px; padding:12px 4px; border-bottom:1px solid var(--kryo-border); text-decoration:none;
    font:500 16px/1.3 var(--kryo-font-body); color:var(--kryo-text); }
  .kryo-su__navrow[data-state="done"]::after { content:'\2713'; color:var(--kryo-blue); font-weight:700; }
  .kryo-su__opts { display:flex; flex-direction:column; gap:8px; margin-bottom:12px; }
  .kryo-su__opt { display:flex; align-items:center; min-height:52px; padding:0 16px; border:1px solid var(--kryo-border);
    border-radius:12px; background:var(--kryo-white); font:600 16px/1.2 var(--kryo-font-body);
    color:var(--kryo-text); text-align:left; text-decoration:none; cursor:pointer; }
  .kryo-su__opt--link { color:var(--kryo-blue); margin-bottom:18px; }
  .kryo-su__opt:active { background:var(--kryo-surface); }

  .kryo-su__zoom { position:fixed; inset:0; z-index:80; background:#0d0f10;
    display:flex; align-items:center; justify-content:center; padding:16px; }
  .kryo-su__zoom[hidden] { display:none; }
  .kryo-su__zoom img { max-width:100%; max-height:100%; object-fit:contain; }
  .kryo-su__zoom__close { position:absolute; top:calc(12px + env(safe-area-inset-top)); right:12px;
    width:48px; height:48px; border-radius:999px; border:0; background:rgba(255,255,255,.18);
    color:#fff; font-size:18px; cursor:pointer; }

  /* ---- Gate form ---- */
  .kryo-su__f { display:block; margin:0 0 14px; }
  .kryo-su__f span { display:block; font:600 13px/1 var(--kryo-font-body); color:var(--kryo-text-secondary); margin-bottom:6px; }
  .kryo-su__f input { width:100%; min-height:52px; padding:12px 14px; font-size:16px; font-family:var(--kryo-font-body);
    background:var(--kryo-white); color:var(--kryo-text); border:1px solid var(--kryo-border-strong); border-radius:12px; }
  .kryo-su__check { display:flex; gap:12px; align-items:flex-start; margin:0 0 14px; min-height:48px; padding:4px 0;
    font-size:14px; line-height:1.5; color:var(--kryo-text-secondary); cursor:pointer; }
  .kryo-su__check input { margin-top:2px; width:22px; height:22px; flex:0 0 auto; }
  .kryo-su__check[hidden] { display:none; }
  .kryo-su__err { color:var(--kryo-danger); font-size:14px; font-weight:600; margin:8px 0 12px; }
  .kryo-su__gateconfirm { margin-bottom:10px; color:var(--kryo-text); font-weight:600; }
  .kryo-su__gatelist { list-style:none; margin:0 0 22px; padding:0; }
  .kryo-su__gatelist li { display:flex; gap:10px; align-items:flex-start; margin:0 0 12px;
    font-size:15px; line-height:1.45; color:var(--kryo-text); }
  .kryo-su__gatetick { flex:0 0 auto; width:20px; height:20px; border-radius:999px;
    background:var(--kryo-blue-bg); position:relative; }
  .kryo-su__gatetick::after { content:'\2713'; position:absolute; inset:0; display:flex;
    align-items:center; justify-content:center; color:var(--kryo-blue-strong);
    font-size:12px; font-weight:700; }
  .kryo-su__gatesecondary { margin:14px 0 0; justify-content:center; }

  .kryo-su__mark:focus-visible, .kryo-su__cta:focus-visible, .kryo-su__alt:focus-visible,
  .kryo-su__barbtn:focus-visible, .kryo-su__opt:focus-visible, .kryo-su__navrow:focus-visible,
  .kryo-su__tocrow:focus-visible, .kryo-su__acc summary:focus-visible, .kryo-su__f input:focus-visible
    { outline:2px solid var(--kryo-blue); outline-offset:2px; }

  @media (prefers-reduced-motion: reduce) {
    .kryo-su__accbody, .kryo-su__qabody, .kryo-su__panel { animation:none !important; }
    .kryo-su__qamark::before, .kryo-su__qamark::after { transition:none; }
    .kryo-su__cta:active { transform:none; }
  }

  /* ---- Desktop: same content, wider measure. Mobile is the source of truth. ---- */
  @media (min-width:990px) {
    .kryo-su__wrap { max-width:900px; padding:36px 32px; }
    .kryo-su__barrow { padding-left:32px; padding-right:32px; }
    .kryo-su__chips { padding-left:32px; padding-right:32px; }
    .kryo-su__logo { height:30px; }
    .kryo-su__h1 { font-size:40px; }
    .kryo-su__h2 { font-size:30px; }
    .kryo-su__media { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .kryo-su__media--detail { grid-template-columns:1fr; }
    .kryo-su__media > *:only-child { grid-column:1 / -1; }
    .kryo-su__chfoot { flex-direction:row; align-items:center; justify-content:space-between; }
    .kryo-su__mark { width:auto; min-width:240px; }
    .kryo-su__sheet { align-items:center; justify-content:center; }
    .kryo-su__panel { max-width:520px; border-radius:20px; max-height:80vh; }
  }
{% endstyle %}

<script>
(function () {
  var root = document.querySelector('[data-kryo-setup]');
  if (!root) return;

  var API  = 'https://everest-calendar.vercel.app/api/marketing/sync/storefront-event';
  var PKEY = 'kryo_setup_progress_v1';
  var AKEY = 'kryo_safety_accepted_v1';
  var SVER = root.getAttribute('data-safety-version') || '1';
  var TVER = root.getAttribute('data-terms-version') || '1';
  var HUB  = root.getAttribute('data-hub') || '/pages/kryo-resources';
  var WA   = root.getAttribute('data-wa') || '';
  var LEGACY_TOTAL = parseInt(root.getAttribute('data-legacy-steps'), 10) || 24;

  var gate  = root.querySelector('[data-kryo-gate]');
  var guide = root.querySelector('[data-kryo-guide]');
  var chapters = [].slice.call(root.querySelectorAll('[data-kryo-ch]'));
  var ANCHORS = chapters.map(function (s) { return s.getAttribute('data-kryo-ch'); });

  function lget(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function lset(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function jparse(s) { try { return JSON.parse(s); } catch (e) { return null; } }

  function sessionId() {
    var o = jparse(lget('el_session') || lget('everest_session'));
    return o ? (o.id || o.session_id || null) : null;
  }
  function track(type, props) {
    try {
      var payload = JSON.stringify({
        event_type: type, session_id: sessionId(), anonymous_id: lget('el_anonymous_id'),
        page_path: location.pathname, page_url: location.href,
        ts: new Date().toISOString(), event_properties: props || {}
      });
      var blob = new Blob([payload], { type: 'text/plain;charset=UTF-8' });
      if (navigator.sendBeacon && navigator.sendBeacon(API, blob)) return;
      fetch(API, { method: 'POST', body: payload, keepalive: true });
    } catch (e) {}
  }

  // ---- Progress, now chapter-level. Old step-level state is MIGRATED, never reset. ----
  // The wizard's chapter boundaries were steps 0-2 / 3-7 / 8-10 / 11-15 / 16-23.
  // Keyed by anchor, not by position: adding "What's in the box" as the first chapter shifted
  // every index and silently mis-migrated existing owners. Anchors not listed here had no
  // equivalent in the wizard and count as done once the owner has any progress at all.
  var LEGACY_LAST = { position: 7, connect: 10, fill: 15, 'first-use': 23 };

  function readProgress() {
    var p = jparse(lget(PKEY)) || {};
    var done = {};
    if (p.chapters && typeof p.chapters === 'object') {
      ANCHORS.forEach(function (a) { if (p.chapters[a]) done[a] = true; });
    } else if (p.completedSteps || p.setupComplete) {
      // Migrate: a chapter counts as done if the wizard had passed its last step.
      var cs = parseInt(p.completedSteps, 10) || 0;
      ANCHORS.forEach(function (a) {
        var last = LEGACY_LAST[a];
        if (p.setupComplete || (last === undefined ? cs > 0 : cs > last)) done[a] = true;
      });
    }
    return { done: done, setupComplete: !!p.setupComplete };
  }

  function writeProgress(done) {
    var count = ANCHORS.filter(function (a) { return done[a]; }).length;
    var complete = count >= ANCHORS.length;
    var firstOpen = ANCHORS.length;
    for (var i = 0; i < ANCHORS.length; i++) { if (!done[ANCHORS[i]]) { firstOpen = i; break; } }
    lset(PKEY, JSON.stringify({
      version: 2,
      chapters: done,
      setupComplete: complete,
      // Legacy fields the owner hub still reads. Kept in sync so the hub needs no change.
      currentChapter: Math.min(firstOpen + 1, ANCHORS.length),
      completedSteps: Math.round((count / ANCHORS.length) * LEGACY_TOTAL)
    }));
  }

  function getKryoOwnerState() {
    var acc = jparse(lget(AKEY)) || null;
    var accepted = !!(acc && acc.accepted_at);
    var pr = readProgress();
    return {
      registered: !!(acc && acc.registered),
      safetyAccepted: accepted,
      safetyVersion: acc ? acc.safety_version : null,
      safetyCurrent: accepted && String(acc.safety_version) === String(SVER),
      chaptersComplete: pr.done,
      setupComplete: pr.setupComplete
    };
  }
  window.getKryoOwnerState = getKryoOwnerState;

  var S = getKryoOwnerState();
  var done = S.chaptersComplete;
  var reAck = S.safetyAccepted && !S.safetyCurrent;

  // ---- Remove storefront distractions during setup ----
  function stripChrome() {
    try {
      [].forEach.call(document.querySelectorAll('[id^="shopify-section"]'), function (s) {
        if (!s.contains(root)) s.style.display = 'none';
      });
      ['#chatway-container', 'chatway-widget', '#shopify-chat', '.announcement-bar', '.newsletter-form']
        .forEach(function (sel) {
          [].forEach.call(document.querySelectorAll(sel), function (el) {
            if (!el.contains(root)) el.style.display = 'none';
          });
        });
      document.body.style.background = '#fff';
    } catch (e) {}
  }
  stripChrome();
  var n = 0, t = setInterval(function () { stripChrome(); if (++n > 8) clearInterval(t); }, 700);

  // ---- Paint chapter state ----
  function paint() {
    var count = 0;
    ANCHORS.forEach(function (a) {
      var isDone = !!done[a];
      if (isDone) count++;
      var row = root.querySelector('[data-kryo-toc="' + a + '"]');
      if (row) row.setAttribute('data-state', isDone ? 'done' : 'todo');
      var chip = root.querySelector('[data-kryo-chip="' + a + '"]');
      if (chip && chip.getAttribute('data-state') !== 'current')
        chip.setAttribute('data-state', isDone ? 'done' : 'todo');
      var mark = root.querySelector('[data-kryo-mark="' + a + '"]');
      if (mark) {
        mark.setAttribute('data-state', isDone ? 'done' : 'todo');
        mark.textContent = isDone
          ? (root.getAttribute('data-marked') || 'Section complete')
          : (root.getAttribute('data-mark-done') || 'Mark section complete');
      }
      var sec = root.querySelector('[data-kryo-ch="' + a + '"]');
      var badge = sec && sec.querySelector('[data-kryo-chdone]');
      if (badge) badge.hidden = !isDone;
    });

    var resume = root.querySelector('[data-kryo-resume]');
    var first = null;
    for (var i = 0; i < ANCHORS.length; i++) { if (!done[ANCHORS[i]]) { first = ANCHORS[i]; break; } }
    if (resume) {
      if (count > 0 && first) {
        resume.hidden = false;
        resume.textContent = root.getAttribute('data-continue-label') || 'Continue setup';
        resume.setAttribute('data-target', first);
      } else { resume.hidden = true; }
    }

    var allDone = count >= ANCHORS.length;
    var tick = root.querySelector('[data-kryo-endtick]');
    if (tick) tick.hidden = !allDone;
    var eh = root.querySelector('[data-kryo-endheading]');
    var eb = root.querySelector('[data-kryo-endbody]');
    if (allDone && eh && eb) {
      eh.textContent = root.getAttribute('data-end-done-heading') || eh.textContent;
      eb.textContent = root.getAttribute('data-end-done-body') || eb.textContent;
    }
  }

  // ---- Smooth scroll that clears the sticky header ----
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function scrollToAnchor(id, push) {
    var el = document.getElementById(id);
    if (!el) return;
    var head = root.querySelector('.kryo-su__bar');
    var top = el.getBoundingClientRect().top + window.scrollY - ((head ? head.offsetHeight : 106) + 8);
    window.scrollTo({ top: top, behavior: reduce ? 'auto' : 'smooth' });
    // One history entry per jump — browser Back returns to where they were reading,
    // it never walks back through twenty individual actions.
    if (push) { try { history.pushState({ kryo: 1, a: id }, '', '#' + id); } catch (e) {} }
    var h = el.querySelector('.kryo-su__h2, .kryo-su__h1');
    if (h) { try { h.focus({ preventScroll: true }); } catch (e) {} }
    track('kryo_setup_chapter_view', { chapter: id, via: 'jump' });
  }

  // ---- Gate ----
  function showGate() {
    gate.hidden = false; guide.hidden = true;
    var fields = root.querySelector('[data-kryo-gate-fields]');
    var rb = root.querySelector('[data-kryo-gate-reack]');
    if (fields) fields.hidden = reAck;
    if (rb) rb.hidden = !reAck;
    var submit = root.querySelector('[data-kryo-gate-submit]');
    if (reAck) {
      var h = root.querySelector('[data-kryo-gate-heading]');
      if (h) h.textContent = root.getAttribute('data-reack-heading') || h.textContent;
      if (submit) submit.textContent = root.getAttribute('data-reack-cta') || 'I understand';
    }
    track('kryo_safety_gate_view', { reack: reAck });
  }

  function showGuide(fromGate) {
    gate.hidden = true; guide.hidden = false;
    paint();
    if (fromGate) { window.scrollTo(0, 0); track('kryo_setup_start', {}); }
    var hash = (location.hash || '').replace('#', '');
    if (hash && (hash === 'overview' || ANCHORS.indexOf(hash) > -1)) {
      setTimeout(function () { scrollToAnchor(hash, false); }, 60);
    }
  }

  function acceptGate() {
    var form = root.querySelector('[data-kryo-gate-form]');
    var err = root.querySelector('[data-kryo-gate-err]');
    var d = new FormData(form);
    var nm = (d.get('name') || '').toString().trim();
    var em = (d.get('email') || '').toString().trim();
    var needDetails = !reAck;
    var okEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em);
    if (!d.get('accept') || (needDetails && (!nm || !okEmail))) {
      if (err) {
        err.hidden = false;
        err.textContent = needDetails
          ? (root.getAttribute('data-err-full') || 'Please add your name, a valid email address and tick the acknowledgement.')
          : (root.getAttribute('data-err-ack') || 'Please tick the acknowledgement to continue.');
      }
      return;
    }
    if (err) err.hidden = true;
    var prev = jparse(lget(AKEY)) || {};
    // PII is deliberately not stored or sent to analytics; only that registration happened.
    lset(AKEY, JSON.stringify({
      registered: needDetails ? true : (prev.registered !== false),
      accepted_at: new Date().toISOString(),
      safety_version: SVER, terms_version: TVER
      // Marketing consent is deliberately NOT collected here — a safety acknowledgement
      // must not be bundled with a marketing opt-in.
    }));
    track('kryo_safety_accept', { reack: reAck });
    reAck = false;
    showGuide(true);
  }

  // ---- Sheets ----
  var lastFocus = null;
  function openSheet(kind) {
    var s = root.querySelector('[data-kryo-sheet="' + kind + '"]');
    if (!s) return;
    lastFocus = document.activeElement;
    if (kind === 'help') {
      var ctx = root.querySelector('[data-kryo-help-ctx]');
      if (ctx) ctx.textContent = currentChapterTitle() || '';
    }
    s.hidden = false;
    document.body.style.overflow = 'hidden';
    var f = s.querySelector('button, a');
    if (f) f.focus();
  }
  function closeSheets() {
    var open = false;
    [].forEach.call(root.querySelectorAll('.kryo-su__sheet'), function (s) { if (!s.hidden) open = true; s.hidden = true; });
    document.body.style.overflow = '';
    if (open && lastFocus && lastFocus.focus) lastFocus.focus();
  }

  // ---- Which chapter is the reader in (for support context + analytics) ----
  var currentAnchor = 'overview';
  function setCurrentChip(a) {
    [].forEach.call(root.querySelectorAll('[data-kryo-chip]'), function (chip) {
      var anchor = chip.getAttribute('data-kryo-chip');
      if (anchor === a) {
        chip.setAttribute('data-state', 'current');
        // Keep the chip you are reading visible in the scrolling row.
        var row = chip.parentNode;
        var want = chip.offsetLeft - (row.clientWidth - chip.offsetWidth) / 2;
        if (Math.abs(row.scrollLeft - want) > 24) row.scrollLeft = Math.max(0, want);
      } else {
        chip.setAttribute('data-state', done[anchor] ? 'done' : 'todo');
      }
    });
  }
  function currentChapterTitle() {
    var sec = root.querySelector('[data-kryo-ch="' + currentAnchor + '"]');
    var h = sec && sec.querySelector('.kryo-su__h2');
    return h ? h.textContent.trim() : '';
  }
  if ('IntersectionObserver' in window) {
    var seen = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var a = e.target.getAttribute('data-kryo-ch');
        if (!a) return;
        currentAnchor = a;
        setCurrentChip(a);
        if (!seen[a]) { seen[a] = 1; track('kryo_setup_chapter_view', { chapter: a, via: 'scroll' }); }
      });
    }, { rootMargin: '-64px 0px -70% 0px' });
    chapters.forEach(function (s) { io.observe(s); });
  }

  // ---- Events ----
  // Help is now triggered from inside the guide (overview + every chapter footer),
  // because the sticky bar carries the five section links.
  [].forEach.call(root.querySelectorAll('[data-kryo-help-open]'), function (btn) {
    if (btn.getAttribute('data-wired')) return;
    btn.setAttribute('data-wired', '1');
    btn.addEventListener('click', function () {
      track('kryo_support_open', { surface: 'setup', chapter: currentAnchor });
      openSheet('help');
    });
  });

  var submitBtn = root.querySelector('[data-kryo-gate-submit]');
  if (submitBtn) submitBtn.addEventListener('click', acceptGate);
  var gateForm = root.querySelector('[data-kryo-gate-form]');
  if (gateForm) gateForm.addEventListener('submit', function (e) { e.preventDefault(); acceptGate(); });

  root.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;

    if (t.closest('[data-kryo-sheet-close]') || t.classList.contains('kryo-su__sheet')) { closeSheets(); return; }

    var jump = t.closest('[data-kryo-jump], [data-kryo-toc], .kryo-su__nextlink');
    if (jump && jump.getAttribute('href')) {
      e.preventDefault();
      closeSheets();
      scrollToAnchor(jump.getAttribute('href').replace('#', ''), true);
      return;
    }

    var resume = t.closest('[data-kryo-resume]');
    if (resume) { scrollToAnchor(resume.getAttribute('data-target'), true); return; }

    var mark = t.closest('[data-kryo-mark]');
    if (mark) {
      var a = mark.getAttribute('data-kryo-mark');
      done[a] = !done[a];
      writeProgress(done);
      paint();
      track(done[a] ? 'kryo_setup_chapter_complete' : 'kryo_setup_chapter_reopen', { chapter: a });
      if (ANCHORS.every(function (x) { return done[x]; })) track('kryo_setup_complete', { chapters: ANCHORS.length });
      return;
    }

    var topic = t.closest('[data-kryo-topic]');
    if (topic) {
      var name = topic.getAttribute('data-kryo-topic');
      var where = currentChapterTitle() || 'Setup overview';
      track('kryo_whatsapp_support_click', { surface: 'setup', topic: name, chapter: currentAnchor });
      if (WA) {
        var msg = encodeURIComponent('KRYO setup help — ' + name + '. I am on: ' + where + '.');
        window.open(WA + (WA.indexOf('?') > -1 ? '&' : '?') + 'text=' + msg, '_blank', 'noopener');
      }
      closeSheets();
      return;
    }

    var zoom = t.closest('[data-kryo-zoom]');
    if (zoom) {
      var v = root.querySelector('[data-kryo-zoomview]');
      var img = root.querySelector('[data-kryo-zoom-img]');
      var inner = zoom.querySelector('img');
      img.src = zoom.getAttribute('data-src');
      img.alt = inner ? inner.alt : '';
      v.hidden = false;
      document.body.style.overflow = 'hidden';
      root.querySelector('[data-kryo-zoom-close]').focus();
      return;
    }
    if (t.closest('[data-kryo-zoom-close]')) {
      root.querySelector('[data-kryo-zoomview]').hidden = true;
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var z = root.querySelector('[data-kryo-zoomview]');
    if (z && !z.hidden) { z.hidden = true; document.body.style.overflow = ''; return; }
    closeSheets();
  });

  window.addEventListener('popstate', function (e) {
    var a = e.state && e.state.kryo ? e.state.a : (location.hash || '').replace('#', '');
    if (a && (a === 'overview' || ANCHORS.indexOf(a) > -1)) scrollToAnchor(a, false);
  });

  if (!S.safetyCurrent) showGate(); else showGuide(false);
})();
</script>

