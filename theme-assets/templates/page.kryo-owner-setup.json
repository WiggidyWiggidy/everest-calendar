          "type": "setup_step",
          "settings": {
            "enabled": true,
            "chapter": 3,
            "chapter_label": "CHAPTER 3 \u00b7 CONNECT KRYO",
            "title": "Fit rubber seals",
            "instruction": "A rubber seal sits flat inside each hose fitting. Check every fitting before connecting.",
            "asset_id": "KRYO-SETUP-09",
            "warning_level": "critical",
            "warning_title": "A MISSING SEAL WILL LEAK",
            "warning": "Hand-tighten connections. Do not cross-thread.",
            "tip": "",
            "why": ""
          }
        },
        "step_10": {
          "type": "setup_step",
          "settings": {
            "enabled": true,
            "chapter": 3,
            "chapter_label": "CHAPTER 3 \u00b7 CONNECT KRYO",
            "title": "Connect Halo and hose",
            "instruction": "Hand-tighten connections. Do not cross-thread. Leave the KRYO water-flow control off and the Halo flow adjuster closed.",
            "asset_id": "KRYO-SETUP-10",
            "warning_level": "caution",
            "warning_title": "",
            "warning": "",
            "tip": "",
            "why": ""
          }
        },
        "step_11": {
          "type": "setup_step",
          "settings": {
            "enabled": true,
            "chapter": 3,
            "chapter_label": "CHAPTER 3 \u00b7 CONNECT KRYO",
            "title": "Connect PSU",
            "instruction": "Power path: UAE outlet \u2192 PSU \u2192 24V DC \u2192 KRYO.",
            "asset_id": "KRYO-SETUP-11",
            "warning_level": "critical",
            "warning_title": "KEEP POWER OUT OF THE WET ZONE",
            "warning": "Keep the PSU and mains connections outside the splash zone. Do not handle mains connections with wet hands.",
            "tip": "",
            "why": ""
          }
        },
