            "asset_id": "KRYO-SETUP-12",
            "warning_level": "critical",
            "warning_title": "NEVER START KRYO DRY",
            "warning": "KRYO must have water before it is switched on.",
            "tip": "",
            "why": ""
          }
        },
        "step_13": {
          "type": "setup_step",
          "settings": {
            "enabled": true,
            "chapter": 4,
            "chapter_label": "CHAPTER 4 \u00b7 FILL & START",
            "title": "Confirm circulation",
            "instruction": "After power-on the internal light should illuminate and normal circulation should be audible.",
            "asset_id": "KRYO-SETUP-13",
            "warning_level": "critical",
            "warning_title": "IF YOU HEAR A HARSH DRY-RUNNING SOUND",
            "warning": "Switch KRYO off immediately and add more water.",
