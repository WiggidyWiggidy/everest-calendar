        "section_05": {
          "type": "section",
          "settings": {
            "title": "First-flow positioning",
            "body": "<p>Stand with your back toward the Halo. Let the first water reach the tops of your shoulders and upper back before slowly rotating.</p><p><strong>Do not direct the first cold flow at your face or chest.</strong></p>",
            "always_open": true
          }
        },
        "section_06": {
          "type": "section",
          "settings": {
            "title": "Temperature safety",
            "body": "<p>Start around 15\u00b0C. Never set KRYO below 1\u00b0C. Never allow the reservoir to freeze.</p>",
            "always_open": true
          }
        },
        "section_07": {
          "type": "section",
          "settings": {
            "title": "Breathing",
            "body": "<p>Breathe normally.</p>",
            "always_open": true
          }
        },
        "section_08": {
          "type": "section",
          "settings": {
            "title": "Electrical safety",
            "body": "<p>Power path: UAE outlet \u2192 PSU \u2192 24V DC \u2192 KRYO. Keep the PSU and mains connections outside the splash zone. Do not handle mains connections with wet hands.</p>",
            "always_open": true
          }
        },
        "section_09": {
          "type": "section",
          "settings": {
            "title": "Filling and pump safety",
            "body": "<p>Never start KRYO dry. If you hear a harsh dry-running sound, switch KRYO off immediately and add more water.</p>",
            "always_open": true
          }
        },
