      .then(function(r){ if(!r.ok) throw new Error('save_failed'); return r.json(); })
      .then(function(){ try{localStorage.setItem(key,JSON.stringify({name:name,email:email,ts:new Date().toISOString()}));}catch(e){} hide(); })
      .catch(function(){ if(err) err.textContent='Could not save the acknowledgement. Please check your connection and try again.'; if(btn){btn.disabled=false;btn.textContent='I have read safety';} });
  });
})();
