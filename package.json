{
  "name": "everest-calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "proof:kryo": "node scripts/kryo-proof-runner.mjs",
    "proof:kryo:full": "node scripts/kryo-proof-runner.mjs --lighthouse",
    "audit:kryo-readiness": "node scripts/kryo-readiness-audit.mjs",
    "audit:kryo-meta-urls": "node scripts/kryo-meta-url-audit.mjs",
    "audit:kryo-system": "npm run audit:kryo-readiness -- --out artifacts/kryo-readiness/latest && npm run audit:kryo-meta-urls -- --out artifacts/kryo-meta-url-audit/latest",
    "gate:kryo": "node scripts/kryo-proof-gate.mjs --mode observe",
    "gate:kryo:pre-spend": "node scripts/kryo-proof-gate.mjs --mode pre_spend",
    "gate:kryo:pre-page": "node scripts/kryo-proof-gate.mjs --mode pre_page --run-proof",
    "health:kryo-tools": "node scripts/kryo-tool-health.mjs",
    "qc:kryo-system": "node scripts/kryo-system-qc.mjs",
    "qc:kryo-system:with-proof": "node scripts/kryo-system-qc.mjs --with-proof",
    "operator:kryo": "node scripts/kryo-operator-action-packet.mjs",
    "operator:kryo:refresh": "node scripts/kryo-operator-action-packet.mjs --refresh",
    "audit:kryo-checkout": "node scripts/kryo-checkout-reconciliation.mjs",
    "audit:kryo-checkout-baseline": "node scripts/kryo-checkout-reconciliation.mjs --start-date 2026-06-01 --end-date 2026-06-14",
    "audit:kryo-source-health": "node scripts/kryo-source-health.mjs",
    "audit:kryo-shopify-readiness": "node scripts/kryo-shopify-readiness.mjs",
    "gate:kryo-recommendations": "node scripts/kryo-recommendation-gate.mjs",
    "audit:kryo-quarantine": "node scripts/kryo-quarantine-check.mjs",
    "operator:kryo-preflight": "node scripts/kryo-preflight.mjs",
    "operator:kryo-growth-brief": "node scripts/kryo-growth-decision-brief.mjs",
    "analyse:kryo-performance": "node scripts/kryo-performance-analyst-pack.mjs",
    "audit:kryo-measurement-spine": "node scripts/kryo-measurement-spine-health.mjs",
    "operator:kryo-experiment-packet": "node scripts/kryo-experiment-packet.mjs",
    "review:kryo-experiment": "node scripts/kryo-experiment-reviewer.mjs",
    "sync:kryo-experiment-ledger": "node scripts/kryo-sync-experiment-ledger.mjs",
    "smoke:kryo-experiment-loop": "node scripts/kryo-experiment-loop-smoke.mjs",
    "operator:kryo-rapid-loop": "npm run audit:kryo-source-health && npm run analyse:kryo-performance && npm run audit:kryo-measurement-spine && npm run operator:kryo-experiment-packet && npm run sync:kryo-experiment-ledger && npm run review:kryo-experiment && npm run smoke:kryo-experiment-loop",
    "report:kryo-experiment-velocity": "node scripts/kryo-experiment-velocity.mjs",
    "audit:kryo-whatsapp-tracking": "node scripts/kryo-whatsapp-tracking-readiness.mjs",
    "audit:kryo-whatsapp-cloud": "node scripts/kryo-whatsapp-cloud-readiness.mjs",
    "audit:kryo-meta-direct": "node scripts/kryo-meta-direct-readiness.mjs",
    "qc:shopify-page": "node scripts/qc-shopify-page.mjs",
    "test:shopify-page-qc": "node --test scripts/qc-shopify-page.test.mjs",
    "release:shopify-backup": "node scripts/shopify-release-guard.mjs backup",
    "release:shopify-restore": "node scripts/shopify-release-guard.mjs restore",
    "release:shopify-guarded": "node scripts/shopify-release-guard.mjs run",
    "shopify:asset": "node scripts/shopify-direct-asset.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.48.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
